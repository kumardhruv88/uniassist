{"id": "VC1", "bucket": "versions_conflicts", "tags": ["as_of", "version", "attendance"], "difficulty": "medium", "question": "What is the minimum attendance required to sit end-semester exams?", "student_id": null, "as_of_date": "2026-07-15", "session": null, "turn": null, "repeat_of": null, "expected_types": ["retrieved_fact"], "expected_answer_type": "retrieved_fact", "reference": "On 15 July 2026: 75% (ACAD-REG-2024 \u00a77.2). Upcoming: ACAD-2026-08 raises it to 80% from 1 August 2026.", "expected_facts": ["75"], "expected_regex": [], "forbidden_facts": [], "expected_sources": ["ACAD-REG-2024#7.2"], "has_forbidden": false, "type_ok": true, "facts_ok": true, "forbidden_ok": true, "tool_ok": null, "citations": ["ACAD-REG-2024#7.2"], "cite_hits": 1, "cite_doc_hits": 1, "forbidden_sources_ok": true, "upcoming_ok": true, "conflict_ok": true, "meta_ok": null, "guardrail_ok": null, "correct": true, "reasons": [], "hallucination": false, "resisted": true, "retrieval_hit": true, "retrieval_hit_any": true, "retrieval_doc_hit": true, "retrieval_rank": 1, "answer_type": "retrieved_fact", "http_status": 200, "answer": "You need to have a minimum of 75% attendance in each course to be eligible to appear in the end-semester examination of that course.", "explanation": "You must attend at least 75% of the sessions in each course to be allowed to take the end-semester exam. This is a requirement for all courses.", "trace_id": "987dd4b7", "latency_ms": 3482, "wall_ms": 3485, "client_wait_s": 0.0, "llm_calls": 2, "tokens": 1733, "fallback": false, "max_score": 0.825, "cache_hit": false, "cache_kind": "miss", "groundedness": 1.0, "guardrail": null, "degraded": false, "planner": "llm", "retrieval_mode": "hybrid+rerank", "rewrite": null, "standalone_question": null, "session_id": null, "retrieved": ["ACAD-REG-2024#7.2", "ACAD-REG-2024#8.1", "ACAD-REG-2024#7", "ACAD-REG-2024#8.4", "ACAD-REG-2024#7.1", "ACAD-REG-2024#8.2", "ACAD-REG-2024#7.3", "EXAM-SUPP-2025#4", "ACAD-REG-2024#8", "FEES-2026#1"], "response": {"answer": "You need to have a minimum of 75% attendance in each course to be eligible to appear in the end-semester examination of that course.", "explanation": "You must attend at least 75% of the sessions in each course to be allowed to take the end-semester exam. This is a requirement for all courses.", "citations": [{"doc_id": "ACAD-REG-2024", "section": "7.2", "title": "Academic Regulations for B.Tech Programmes", "version": "3.1", "effective_from": "2024-07-01"}], "tools": [{"tool": "get_rule", "input": {"parameter": "min_attendance_pct"}, "output": {"by_scope": [{"scope": "B.Tech", "rule_id": "ATT-MIN-01", "operator": ">=", "value": "75", "source_doc_id": "ACAD-REG-2024", "source_section": "7.2"}, {"scope": "other programmes", "result": "RULE_UNAVAILABLE"}]}, "status": "ok"}], "applied_rules": [{"rule_id": "ATT-MIN-01", "value": ">=75%", "source_doc_id": "ACAD-REG-2024", "source_section": "7.2", "parameter": "min_attendance_pct"}], "conflicts": [], "upcoming": ["ACAD-2026-08", "HELPDESK-FAQ-2026"], "clarification_options": [], "meta": {"cache_hit": false, "cache": "miss", "latency_ms": 3482, "guardrail": null, "output_redactions": [], "groundedness": 1.0, "session_id": null, "standalone_question": null, "rewrite": null, "degraded": false, "planner": "llm", "retrieval": "hybrid+rerank", "llm_calls": 2, "tokens": 1733, "tokens_saved": 0}}}
{"id": "VC2", "bucket": "versions_conflicts", "tags": ["conflict", "supersession", "attendance"], "difficulty": "medium", "question": "Which rule sets the minimum attendance now, the regulations or the new circular?", "student_id": null, "as_of_date": "2026-10-06", "session": null, "turn": null, "repeat_of": null, "expected_types": ["retrieved_fact"], "expected_answer_type": "retrieved_fact", "reference": "The circular ACAD-2026-08 (80%, from 1 August 2026) replaces clause 7.2 of the regulations (75%): resolved by supersession.", "expected_facts": ["80"], "expected_regex": [], "forbidden_facts": [], "expected_sources": ["ACAD-2026-08#1"], "has_forbidden": false, "type_ok": true, "facts_ok": false, "forbidden_ok": true, "tool_ok": null, "citations": ["ACAD-2026-08#1", "ACAD-2026-08#None"], "cite_hits": 1, "cite_doc_hits": 2, "forbidden_sources_ok": true, "upcoming_ok": true, "conflict_ok": true, "meta_ok": null, "guardrail_ok": null, "correct": false, "reasons": ["missing 80"], "hallucination": false, "resisted": true, "retrieval_hit": true, "retrieval_hit_any": true, "retrieval_doc_hit": true, "retrieval_rank": 1, "answer_type": "retrieved_fact", "http_status": 200, "answer": "The new circular sets the minimum attendance now.", "explanation": "You should refer to the new circular for the current minimum attendance requirement. The new circular supersedes the previous regulations.", "trace_id": "f4097dfd", "latency_ms": 3187, "wall_ms": 3192, "client_wait_s": 0.0, "llm_calls": 2, "tokens": 1831, "fallback": false, "max_score": 0.774, "cache_hit": false, "cache_kind": "miss", "groundedness": 1.0, "guardrail": null, "degraded": false, "planner": "llm", "retrieval_mode": "hybrid+rerank", "rewrite": null, "standalone_question": null, "session_id": null, "retrieved": ["ACAD-2026-08#1", "ACAD-2026-08#None", "ACAD-REG-2024#7", "ACAD-REG-2024#1.1", "ACAD-REG-2024#7.3", "EXAM-SUPP-2025#None", "ACAD-REG-2024#7.1", "ACAD-2026-08#2", "ACAD-REG-2024#None", "ACAD-2026-08#3"], "response": {"answer": "The new circular sets the minimum attendance now.", "explanation": "You should refer to the new circular for the current minimum attendance requirement. The new circular supersedes the previous regulations.", "citations": [{"doc_id": "ACAD-2026-08", "section": "1", "title": "Circular: Revised minimum attendance requirement", "version": "1", "effective_from": "2026-08-01"}, {"doc_id": "ACAD-2026-08", "section": null, "title": "Circular: Revised minimum attendance requirement", "version": "1", "effective_from": "2026-08-01"}], "tools": [{"tool": "get_rule", "input": {"parameter": "min_attendance_pct"}, "output": {"by_scope": [{"scope": "B.Tech", "rule_id": "AUTO-ACAD-2026-08-ATT-1", "operator": ">=", "value": "80", "source_doc_id": "ACAD-2026-08", "source_section": "1"}, {"scope": "other programmes", "rule_id": "AUTO-ACAD-2026-08-ATT-1", "operator": ">=", "value": "80", "source_doc_id": "ACAD-2026-08", "source_section": "1"}]}, "status": "ok"}], "applied_rules": [{"rule_id": "AUTO-ACAD-2026-08-ATT-1", "value": ">=80%", "source_doc_id": "ACAD-2026-08", "source_section": "1", "parameter": "min_attendance_pct"}], "conflicts": [{"topic": "min_attendance_pct", "winner": {"doc_id": "ACAD-2026-08", "section": "1", "value": "80", "title": "Circular: Revised minimum attendance requirement", "reason": null, "effective_from": "2026-08-01"}, "others": [{"doc_id": "ACAD-REG-2024", "section": "7.2", "value": "75", "title": "Academic Regulations for B.Tech Programmes", "reason": "replaced by ACAD-2026-08", "effective_from": "2024-07-01"}, {"doc_id": "HELPDESK-FAQ-2026", "section": "3", "value": "65", "title": "Student Help-desk FAQ 2026-27", "reason": "lower authority", "effective_from": "2026-09-15"}], "resolved_by": "step2_supersession"}, {"topic": "min_attendance_pct", "winner": {"doc_id": "ACAD-2026-08", "section": "1", "value": "80", "title": "Circular: Revised minimum attendance requirement", "reason": null, "effective_from": "2026-08-01"}, "others": [{"doc_id": "HELPDESK-FAQ-2026", "section": "3", "value": "65", "title": "Student Help-desk FAQ 2026-27", "reason": "lower authority", "effective_from": "2026-09-15"}], "resolved_by": "step3_authority"}], "upcoming": [], "clarification_options": [], "meta": {"cache_hit": false, "cache": "miss", "latency_ms": 3187, "guardrail": null, "output_redactions": [], "groundedness": 1.0, "session_id": null, "standalone_question": null, "rewrite": null, "degraded": false, "planner": "llm", "retrieval": "hybrid+rerank", "llm_calls": 2, "tokens": 1831, "tokens_saved": 0}}}
{"id": "VC3", "bucket": "versions_conflicts", "tags": ["conflict", "authority", "condonation", "attendance"], "difficulty": "hard", "question": "Is 65% attendance enough if I have a medical certificate?", "student_id": null, "as_of_date": "2026-10-06", "session": null, "turn": null, "repeat_of": null, "expected_types": ["retrieved_fact"], "expected_answer_type": "retrieved_fact", "reference": "No. The minimum is 80% (ACAD-2026-08 \u00a71); medical condonation (\u00a77.3) covers a shortage of at most 10%, so 65% is not enough. The help-desk FAQ's 'yes' is outdated and lower in authority.", "expected_facts": ["80"], "expected_regex": [], "forbidden_facts": ["yes, 65"], "expected_sources": ["ACAD-2026-08#1", "ACAD-2026-08#2", "ACAD-REG-2024#7.3"], "has_forbidden": true, "type_ok": true, "facts_ok": true, "forbidden_ok": true, "tool_ok": null, "citations": ["ACAD-REG-2024#7.3", "ACAD-2026-08#1"], "cite_hits": 2, "cite_doc_hits": 2, "forbidden_sources_ok": true, "upcoming_ok": true, "conflict_ok": true, "meta_ok": null, "guardrail_ok": null, "correct": true, "reasons": [], "hallucination": false, "resisted": true, "retrieval_hit": true, "retrieval_hit_any": true, "retrieval_doc_hit": true, "retrieval_rank": 1, "answer_type": "retrieved_fact", "http_status": 200, "answer": "No: 65% is below the 80% minimum, and condonation on medical grounds covers a shortage of at most 10%, so attendance must be at least 70% even with a medical certificate.", "explanation": "You need to have at least 80% attendance, and a medical certificate can only cover a shortage of up to 10%. Since 65% is below the minimum, you must attend at least 70% of the sessions, even with a medical certificate.", "trace_id": "38487242", "latency_ms": 3129, "wall_ms": 3134, "client_wait_s": 0.0, "llm_calls": 1, "tokens": 1203, "fallback": false, "max_score": 0.898, "cache_hit": false, "cache_kind": "miss", "groundedness": 1.0, "guardrail": null, "degraded": false, "planner": "router_first", "retrieval_mode": "hybrid+rerank", "rewrite": null, "standalone_question": null, "session_id": null, "retrieved": ["ACAD-REG-2024#7.3", "ACAD-2026-08#1", "HELPDESK-FAQ-2026#3", "ACAD-REG-2024#7.1", "ACAD-REG-2024#7", "ACAD-REG-2024#8.2", "ACAD-2026-08#None", "SC-POST-2026#None", "ACAD-2026-08#2", "ACAD-2026-08#3"], "response": {"answer": "No: 65% is below the 80% minimum, and condonation on medical grounds covers a shortage of at most 10%, so attendance must be at least 70% even with a medical certificate.", "explanation": "You need to have at least 80% attendance, and a medical certificate can only cover a shortage of up to 10%. Since 65% is below the minimum, you must attend at least 70% of the sessions, even with a medical certificate.", "citations": [{"doc_id": "ACAD-REG-2024", "section": "7.3", "title": "Academic Regulations for B.Tech Programmes", "version": "3.1", "effective_from": "2024-07-01"}, {"doc_id": "ACAD-2026-08", "section": "1", "title": "Circular: Revised minimum attendance requirement", "version": "1", "effective_from": "2026-08-01"}], "tools": [{"tool": "check_attendance_value", "input": {"attendance_pct": "65", "medical_certificate": true}, "output": {"minimum_pct": 80.0, "rule_id": "AUTO-ACAD-2026-08-ATT-1", "condonable_pct": 10.0, "lowest_with_condonation_pct": 70.0, "condonation_rule_id": "ATT-COND-01", "result": "BELOW_CONDONABLE_FLOOR"}, "status": "ok"}], "applied_rules": [{"rule_id": "AUTO-ACAD-2026-08-ATT-1", "value": ">=80%", "source_doc_id": "ACAD-2026-08", "source_section": "1", "parameter": "min_attendance_pct"}, {"rule_id": "ATT-COND-01", "value": "<=10%", "source_doc_id": "ACAD-REG-2024", "source_section": "7.3", "parameter": "max_condonation_pct"}], "conflicts": [{"topic": "min_attendance_pct", "winner": {"doc_id": "ACAD-2026-08", "section": "1", "value": "80", "title": "Circular: Revised minimum attendance requirement", "reason": null, "effective_from": "2026-08-01"}, "others": [{"doc_id": "ACAD-REG-2024", "section": "7.2", "value": "75", "title": "Academic Regulations for B.Tech Programmes", "reason": "replaced by ACAD-2026-08", "effective_from": "2024-07-01"}, {"doc_id": "HELPDESK-FAQ-2026", "section": "3", "value": "65", "title": "Student Help-desk FAQ 2026-27", "reason": "lower authority", "effective_from": "2026-09-15"}], "resolved_by": "step2_supersession"}], "upcoming": [], "clarification_options": [], "meta": {"cache_hit": false, "cache": "miss", "latency_ms": 3129, "guardrail": null, "output_redactions": [], "groundedness": 1.0, "session_id": null, "standalone_question": null, "rewrite": null, "degraded": false, "planner": "router_first", "retrieval": "hybrid+rerank", "llm_calls": 1, "tokens": 1203, "tokens_saved": 41}}}
{"id": "VC4", "bucket": "versions_conflicts", "tags": ["conflict", "authority", "attendance"], "difficulty": "medium", "question": "The student council says there is no minimum attendance this semester. Is that right?", "student_id": null, "as_of_date": "2026-10-06", "session": null, "turn": null, "repeat_of": null, "expected_types": ["retrieved_fact"], "expected_answer_type": "retrieved_fact", "reference": "No. The minimum attendance is 80% (ACAD-2026-08 \u00a71); the student council post is unofficial and cannot override university rules.", "expected_facts": ["80"], "expected_regex": [], "forbidden_facts": [], "expected_sources": [], "has_forbidden": false, "type_ok": true, "facts_ok": true, "forbidden_ok": true, "tool_ok": null, "citations": ["ACAD-2026-08#1"], "cite_hits": null, "cite_doc_hits": null, "forbidden_sources_ok": true, "upcoming_ok": true, "conflict_ok": true, "meta_ok": null, "guardrail_ok": null, "correct": true, "reasons": [], "hallucination": false, "resisted": true, "retrieval_hit": null, "retrieval_hit_any": null, "retrieval_doc_hit": null, "retrieval_rank": null, "answer_type": "retrieved_fact", "http_status": 200, "answer": "With effect from 1 August 2026, the minimum attendance required to appear in the end-semester examination is raised to 80% in each course. This circular replaces clause 7.2 of the Academic\nRegulations (ACAD-REG-2024).", "explanation": "Quoted from Circular: Revised minimum attendance requirement, \u00a71.", "trace_id": "59dd9ab5", "latency_ms": 5839, "wall_ms": 5841, "client_wait_s": 0.0, "llm_calls": 3, "tokens": 2848, "fallback": true, "max_score": 0.804, "cache_hit": false, "cache_kind": "miss", "groundedness": 1.0, "guardrail": null, "degraded": false, "planner": "llm", "retrieval_mode": "hybrid+rerank", "rewrite": null, "standalone_question": null, "session_id": null, "retrieved": ["ACAD-2026-08#1", "ACAD-REG-2024#7", "HELPDESK-FAQ-2026#3", "ACAD-2026-08#None", "ACAD-REG-2024#5.1", "ACAD-REG-2024#7.3", "ACAD-REG-202