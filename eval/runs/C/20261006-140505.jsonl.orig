 for B.Tech Programmes", "reason": "replaced by ACAD-2026-08", "effective_from": "2024-07-01"}, {"doc_id": "HELPDESK-FAQ-2026", "section": "3", "value": "65", "title": "Student Help-desk FAQ 2026-27", "reason": "lower authority", "effective_from": "2026-09-15"}], "resolved_by": "step2_supersession"}, {"topic": "min_attendance_pct", "winner": {"doc_id": "ACAD-2026-08", "section": "1", "value": "80", "title": "Circular: Revised minimum attendance requirement", "reason": null, "effective_from": "2026-08-01"}, "others": [{"doc_id": "HELPDESK-FAQ-2026", "section": "3", "value": "65", "title": "Student Help-desk FAQ 2026-27", "reason": "lower authority", "effective_from": "2026-09-15"}], "resolved_by": "step3_authority"}], "upcoming": [], "clarification_options": [], "meta": {"cache_hit": false, "cache": "miss", "latency_ms": 3633, "guardrail": null, "output_redactions": [], "groundedness": 1.0, "session_id": null, "standalone_question": null, "rewrite": null, "degraded": false, "planner": "llm", "retrieval": "hybrid+rerank", "llm_calls": 2, "tokens": 1920, "tokens_saved": 0}}}
{"id": "CD3", "bucket": "policy_fact", "tags": ["condonation"], "difficulty": "easy", "question": "Within how many days must the medical certificate be submitted for condonation?", "student_id": null, "as_of_date": "2026-10-06", "session": null, "turn": null, "repeat_of": null, "expected_types": ["retrieved_fact"], "expected_answer_type": "retrieved_fact", "reference": "Within seven days of resuming classes (ACAD-REG-2024 \u00a77.3).", "expected_facts": [], "expected_regex": ["(?:seven|7) days"], "forbidden_facts": [], "expected_sources": ["ACAD-REG-2024#7.3"], "has_forbidden": false, "type_ok": true, "facts_ok": true, "forbidden_ok": true, "tool_ok": null, "citations": ["ACAD-REG-2024#7.3"], "cite_hits": 1, "cite_doc_hits": 1, "forbidden_sources_ok": true, "upcoming_ok": true, "conflict_ok": true, "meta_ok": null, "guardrail_ok": null, "correct": true, "reasons": [], "hallucination": false, "resisted": true, "retrieval_hit": true, "retrieval_hit_any": true, "retrieval_doc_hit": true, "retrieval_rank": 1, "answer_type": "retrieved_fact", "http_status": 200, "answer": "You must submit the medical certificate within seven days of resuming classes.", "explanation": "You need to submit the medical certificate within seven days of resuming classes to be eligible for condonation on medical grounds.", "trace_id": "af67d368", "latency_ms": 3330, "wall_ms": 3333, "client_wait_s": 0.0, "llm_calls": 2, "tokens": 1635, "fallback": false, "max_score": 0.815, "cache_hit": false, "cache_kind": "miss", "groundedness": 1.0, "guardrail": null, "degraded": false, "planner": "llm", "retrieval_mode": "hybrid+rerank", "rewrite": null, "standalone_question": null, "session_id": null, "retrieved": ["ACAD-REG-2024#7.3", "ACAD-2026-08#2", "HELPDESK-FAQ-2026#3", "ACAD-REG-2024#7.4", "EXAM-SUPP-2025#5", "HELPDESK-FAQ-2026#2", "HELPDESK-FAQ-2026#1", "EXAM-SUPP-2025#3", "ACAD-REG-2024#1.2", "EXAM-SUPP-2025#2"], "response": {"answer": "You must submit the medical certificate within seven days of 