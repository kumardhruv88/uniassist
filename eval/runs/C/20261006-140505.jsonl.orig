is non-refundable once paid.", "citations": [{"doc_id": "EXAM-SUPP-2025", "section": "3", "title": "Circular: Supplementary Examinations - Eligibility and Fees", "version": "1", "effective_from": "2025-01-15"}], "tools": [{"tool": "get_rule", "input": {"parameter": "supplementary_allowed_results"}, "output": {"by_scope": [{"scope": "B.Tech", "rule_id": "SUPP-ELIG-01", "operator": "in", "value": "FAIL;ABSENT", "source_doc_id": "ACAD-REG-2024", "source_section": "8.3"}, {"scope": "other programmes", "rule_id": "AUTO-EXAM-SUPP-2025-SUPP-1", "operator": "in", "value": "FAIL;ABSENT", "source_doc_id": "EXAM-SUPP-2025", "source_section": "1"}]}, "status": "ok"}], "applied_rules": [{"rule_id": "SUPP-ELIG-01", "value": "inFAIL;ABSENT", "source_doc_id": "ACAD-REG-2024", "source_section": "8.3", "parameter": "supplementary_allowed_results"}, {"rule_id": "AUTO-EXAM-SUPP-2025-SUPP-1", "value": "inFAIL;ABSENT", "source_doc_id": "EXAM-SUPP-2025", "source_section": "1", "parameter": "supplementary_allowed_results"}], "conflicts": [], "upcoming": [], "clarification_options": [], "meta": {"cache_hit": false, "cache": "miss", "latency_ms": 3058, "guardrail": null, "output_redactions": [], "groundedness": 1.0, "session_id": null, "standalone_question": null, "rewrite": null, "degraded": false, "planner": "llm", "retrieval": "hybrid+rerank", "llm_calls": 2, "tokens": 1807, "tokens_saved": 63}}}
{"id": "TF8", "bucket": "policy_fact", "tags": ["fees"], "difficulty": "easy", "question": "What is the fine for paying semester fees after the last date?", "student_id": null, "as_of_date": "2026-10-06", "session": null, "turn": null, "repeat_of": null, "expected_types": ["retrieved_fact"], "expected_answer_type": "retrieved_fact", "reference": "INR 100 per day after the last date, up to a maximum of INR 3,000; registration is not confirmed until the fee is paid (FEES-2026 \u00a73).", "expected_facts": ["100", "3000"], "expected_regex": [], "forbidden_facts": [], "expected_sources": ["FEES-2026#3"], "has_forbidden": false, "type_ok": true, "facts_ok": true, "forbidden_ok": true, "tool_ok": null, "citations": ["FEES-2026#3"], "cite_hits": 1, "cite_doc_hits": 1, "forbidden_sources_ok": true, "upcoming_ok": true, "conflict_ok": true, "meta_ok": null, "guardrail_ok": null, "correct": true, "reasons": [], "hallucination": false, "resisted": true, "retrieval_hit": true, "retrieval_hit_any": true, "retrieval_doc_hit": true, "retrieval_rank": 1, "answer_type": "retrieved_fact", "http_status": 200, "answer": "You will be charged a fine of INR 100 per day, up to a maximum of INR 3,000, for paying semester fees after the last date.", "explanation": "You need to pay the fee on or before the last date to avoid any fine. If you pay late, you will be charged INR 100 per day, and this fine will not exceed INR 3,000.", "trace_id": "757ad108", "latency_ms": 3927, "wall_ms": 3930, "client_wait_s": 0.0, "llm_calls": 2, "tokens": 1762, "fallback": false, "max_score": 0.819, "cache_hit": false, "cache_kind": "miss", "groundedness": 1.0, "guardrail": null, "degraded": false, "planner": "llm", "retrieval_mode": "hybrid+rerank", "rewrite": null, "standalone_question": null, "session_id": null, "retrieved": ["FEES-2026#3", "FEES-2026#1", "EXAM-SUPP-2025#3", "FEES-2026#2", "EXAM-SUPP-2025#2", "EXAM-SUPP-2025#3", "HELPDESK-FAQ-2026#1", "FEES-2026#1", "FEES-2026#2", "FEES-2026#None"], "response": {"answer": "You will be charged a fine of INR 100 per day, up to a maximum of INR 3,000, for paying semester fees after the last date.", "explanation": "You need to pay the fee on or before the last date to avoid any fine. If you pay late, you will be charged INR 100 per day, and this fine will not exceed INR 3,000.", "citations": [{"doc_id": "FEES-2026", "section": "3", "title": "Fee Structure for the Academic Year 2026-27", "version": "1", "effective_from": "2026-07-01"}], "tools": [], "applied_rules": [], "conflicts": [], "upcoming": [], "clarification_options": [], "meta": {"cache_hit": false, "cache": "miss", "latency_ms": 3927, "guardrail": null, "output_redactions": [], "groundedness": 1.0, "session_id": null, "standalone_question": null, "rewrite": null, "degraded": false, "planner": "llm", "retrieval": "hybrid+rerank", "llm_calls": 2, "tokens": 1762, "tokens_saved": 0}}}
{"id": "TF9", "bucket": "policy_fact", "tags": ["table", "grading"], "difficulty": "medium", "question": "What letter grade and grade points does a student get for 85 aggregate marks?", "student_id": null, "as_of_date": "2026-10-06", "session": null, "turn": null, "repeat_of": null, "expected_types": ["retrieved_fact"], "expected_answer_type": "retrieved_fact", "reference": "A+ (Excellent), 9 grade points: the 80-89 band of the grading table (ACAD-REG-2024 \u00a79.1).", "expected_facts": ["a+", "9"], "expected_regex": [], "forbidden_facts": [], "expected_sources": ["ACAD-REG-2024#9.1"], "has_forbidden": false, "type_ok": true, "facts_ok": true, "forbidden_ok": true, "tool_ok": null, "citations": ["ACAD-REG-2024#9.1", "ACAD-REG-2024#8.2"], "cite_hits": 1, "cite_doc_hits": 2, "forbidden_sources_ok": true, "upcoming_ok": true, "conflict_ok": true, "meta_ok": null, "guardrail_ok": null, "correct": true, "reasons": [], "hallucination": false, "resisted": true, "retrieval_hit": true, "retrieval_hit_any": true, "retrieval_doc_hit": true, "retrieval_rank": 2, "answer_type": "retrieved_fact", "http_status": 200, "answer": "You get a grade of B+ and 7 grade points for 85 aggregate marks.", "explanation": "You pass the course because you secured 85 marks, which is above the 40% minimum required. According to the grading table, an aggregate of 80-89 marks corresponds to a grade of A+ and 9 grade points, but since you have 85 marks, which is just above 80, you get a grade of B+ and 7 grade points.", "trace_id": "a2e0b199", "latency_ms": 4146, "wall_ms": 4149, "client_wait_s": 0.0, "llm_calls": 2, "tokens": 1828, "fallback": false, "max_score": 0.831, "cache_hit": false, "cache_kind": "miss", "groundedness": 1.0, "guardrail": null, "degraded": false, "planner": "llm", "retrieval_mode": "hybrid+rerank", "rewrite": null, "standalone_question": null, "session_id": null, "retrieved": ["ACAD-REG-2024#8.2", "ACAD-REG-2024#9.1", "ACAD-REG-2024#9.1", "ACAD-REG-2024#9.2", "ACAD-REG-2024#8.1", "ACAD-REG-2024#8.4", "EXAM-SUPP-2025#5", "ACAD-REG-2024#5.1", "ACAD-REG-2024#8.3", "ACAD-REG-2024#5.2"], "response": {"answer": "You get a grade of B+ and 7 grade points for 85 aggregate marks.", "explanation": "You pass the course because you secured 85 marks, which is above the 40% minimum required. According to the grading table, an aggregate of 80-89 marks corresponds to a grade of A+ and 9 grade points, but since you have 85 marks, which is just above 80, you get a grade of B+ and 7 grade points.", "citations": [{"doc_id": "ACAD-REG-2024", "section": "9.1", "title": "Academic Regulations for B.Tech Programmes", "version": "3.1", "effective_from": "2024-07-01"}, {"doc_id": "ACAD-REG-2024", "section": "8.2", "title": "Academic Regulations for B.Tech Programmes", "version": "3.1", "effective_from": "2024-07-01"}], "tools": [{"tool": "get_rule", "input": {"parameter": "pass_min_total_pct"}, "output": {"scope": "B.Tech", "rule_id": "PASS-MIN-01", "operator": ">=", "value": "40", "source_doc_id": "ACAD-REG-2024", "source_section": "8.2"}, "status": "ok"}], "applied_rules": [{"rule_id": "PASS-MIN-01", "value": ">=40%", "source_doc_id": "ACAD-REG-2024", "source_section": "8.2", "parameter": "pass_min_total_pct"}], "conflicts": [], "upcoming": [], "clarification_options": [], "meta": {"cache_hit": false, "cache": "miss", "latency_ms": 4146, "guardrail": null, "output_redactions": [], "groundedness": 1.0, "session_id": null, "standalone_question": null, "rewrite": null, "degraded": false, "planner": "llm", "retrieval": "hybrid+rerank", "llm_calls": 2, "tokens": 1828, "tokens_saved": 0}}}
{"id": "CD1", "bucket": "policy_fact", "tags": ["condonation", "attendance"], "difficulty": "medium", "question": "Can a shortage of attendance be condoned on medical grounds?", "student_id": null, "as_of_date": "2026-10-06", "session": null, "turn": null, "repeat_of": null, "expected_types": ["retrieved_fact"], "expected_answer_type": "retrieved_fact", "reference": "Yes. The Dean (Academics) may condone a shortage of up to 10% on medical grounds, with a medical certificate submitted within seven days of resuming classes; not for laboratory courses (ACAD-REG-2024 \u00a77.3, kept by ACAD-2026-08 \u00a72).", "expected_facts": ["10"], "expected_regex": ["medical certificate"], "forbidden_facts": [], "expected_sources": ["ACAD-REG-2024#7.3", "ACAD-2026-08#2"], "has_forbidden": false, "type_ok": true, "facts_ok": false, "forbidden_ok": true, "tool_ok": null, "citations": ["ACAD-2026-08#1", "ACAD-2026-08#2", "ACAD-REG-2024#7.3"], "cite_hits": 2, "cite_doc_hits": 3, "forbidden_sources_ok": true, "upcoming_ok": true, "conflict_ok": true, "meta_ok": null, "guardrail_ok": null, "correct": false, "reasons": ["missing /medical certificate/"], "hallucination": false, "resisted": true, "retrieval_hit": true, "retrieval_hit_any": true, "retrieval_doc_hit": true, "retrieval_rank": 1, "answer_type": "retrieved_fact", "http_status": 200, "answer": "You can have a shortage of attendance condoned on medical grounds, but only up to 10%.", "explanation": "You can have a shortage of attendance condoned on medical grounds, but only up to 10%. This is because the circular states that condonation under clause 7.3 of the Academic Regulations continues to apply on medical grounds. Clause 7.3 itself states that the Dean (Academics) may condone a shortage of attendance of up to 10% on medical grounds.", "trace_id": "aa5ae02e", "latency_ms": 4446, "wall_ms": 4449, "client_wait_s": 0.0, "llm_calls": 2, "tokens": 1881, "fallback": false, "max_score": 0.748, "cache_hit": false, "cache_kind": "miss", "groundedness": 1.0, "guardrail": null, "degraded": false, "planner": "llm", "retrieval_mode": "hybrid+rerank", "rewrite": null, "standalone_question": null, "session_id": null, "retrieved": ["ACAD-REG-2024#7.3", "ACAD-2026-08#1", "ACAD-2026-08#2", "HELPDESK-FAQ-2026#3", "ACAD-REG-2024#7", "ACAD-REG-2024#7.4", "ACAD-REG-2024#7.1", "ACAD-2026-08#None", "ACAD-2026-08#3", "SC-POST-2026#None"], "response": {"answer": "You can have a shortage of attendance condoned on medical grounds, but only up to 10%.", "explanation": "You can have a shortage of attendance condoned on medical grounds, but only up to 10%. This is because the circular states that condonation under clause 7.3 of the Academic Regulations continues to apply on medical grounds. Clause 7.3 itself states that the Dean (Academics) may condone a shortage of attendance of up to 10% on medical grounds.", "citations": [{"doc_id": "ACAD-2026-08", "section": "1", "title": "Circular: Revised minimum attendance requirement", "version": "1", "effective_from": "2026-08-01"}, {"doc_id": "ACAD-2026-08", "section": "2", "title": "Circular: Revised minimum attendance requirement", "version": "1", "effective_from": "2026-08-01"}, {"doc_id": "ACAD-REG-2024", "section": "7.3", "title": "Academic Regulations for B.Tech Programmes", "version": "3.1", "effective_from": "2024-07-01"}], "tools": [{"tool": "get_rule", "input": {"parameter": "min_attendance_pct"}, "output": {"by_scope": [{"scope": "B.Tech", "rule_id": "AUTO-ACAD-2026-08-ATT-1", "operator": ">=", "value": "80", "source_doc_id": "ACAD-2026-08", "source_section": "1"}, {"scope": "other programmes", "rule_id": "AUTO-ACAD-2026-08-ATT-1", "operator": ">=", "value": "80", "source_doc_id": "ACAD-2026-08", "source_section": "1"}]}, "status": "ok"}, {"tool": "get_rule", "input": {"parameter": "max_condonation_pct"}, "output": {"scope": "B.Tech", "rule_id": "ATT-COND-01", "operator": "<=", "value": "10", "source_doc_id": "ACAD-REG-2024", "source_section": "7.3"}, "status": "ok"}], "applied_rules": [{"rule_id": "AUTO-ACAD-2026-08-ATT-1", "value": ">=80%", "source_doc_id": "ACAD-2026-08", "source_section": "1", "parameter": "min_attendance_pct"}, {"rule_id": "ATT-COND-01", "value": "<=10%", "source_doc_id": "ACAD-REG-2024", "source_section": "7.3", "parameter": "max_condonation_pct"}], "conflicts": [{"topic": "min_attendance_pct", "winner": {"doc_id": "ACAD-2026-08", "section": "1", "value": "80", "title": "Circular: Revised minimum attendance requirement", "reason": null, "effective_from": "2026-08-01"}, "others": [{"doc_id": "ACAD-REG-2024", "section": "7.2", "value": "75", "title": "Academic Regulations for B.Tech Programmes", "reason": "replaced by ACAD-2026-08", "effective_from": "2024-07-01"}, {"doc_id": "HELPDESK-FAQ-2026", "section": "3", "value": "65", "title": "Student Help-desk FAQ 2026-27", "reason": "lower authority", "effective_from": "2026-09-15"}], "resolved_by": "step2_supersession"}, {"topic": "min_attendance_pct", "winner": {"doc_id": "ACAD-2026-08", "section": "1", "value": "80", "title": "Circular: Revised minimum attendance requirement", "reason": null, "effective_from": "2026-08-01"}, "others": [{"doc_id": "HELPDESK-FAQ-2026", "section": "3", "value": "65", "title": "Student Help-desk FAQ 2026-27", "reason": "lower authority", "effective_from": "2026-09-15"}], "resolved_by": "step3_authority"}], "upcoming": [], "clarification_options": [], "meta": {"cache_hit": false, "cache": "miss", "latency_ms": 4446, "guardrail": null, "output_redactions": [], "groundedness": 1.0, "session_id": null, "standalone_question": null, "rewrite": null, "degraded": false, "planner": "llm", "retrieval": "hybrid+rerank", "llm_calls": 2, "tokens": 1881, "tokens_saved": 41}}}
{"id": "CD2", "bucket": "policy_fact", "tags": ["condonation", "attendance"], "difficulty": "medium", "question": "Can attendance shortage in a laboratory course be condoned?", "student_id": null, "as_of_date": "2026-10-06", "session": null, "turn": null, "repeat_of": null, "expected_types": ["retrieved_fact"], "expected_answer_type": "retrieved_fact", "reference": "No. Condonation is not granted for laboratory courses (ACAD-REG-2024 \u00a77.3).", "expected_facts": [], "expected_regex": ["(?:^|[.!] )no\\b|not (?:be )?(?:granted|condoned|allowed|available|permitted|applicable)|cannot be condoned"], "forbidden_facts": [], "expected_sources": ["ACAD-REG-2024#7.3"], "has_forbidden": false, "type_ok": true, "facts_ok": true, "forbidden_ok": true, "tool_ok": null, "citations": ["ACAD-2026-08#1", "ACAD-REG-2024#7.3"], "cite_hits": 1, "cite_doc_hits": 1, "forbidden_sources_ok": true, "upcoming_ok": true, "conflict_ok": true, "meta_ok": null, "guardrail_ok": null, "correct": true, "reasons": [], "hallucination": false, "resisted": true, "retrieval_hit": true, "retrieval_hit_any": true, "retrieval_doc_hit": true, "retrieval_rank": 1, "answer_type": "retrieved_fact", "http_status": 200, "answer": "No, attendance shortage in a laboratory course cannot be condoned.", "explanation": "You cannot be granted condonation for a laboratory course, as per the regulations. Condonation is not granted for laboratory courses, as stated in the Academic Regulations for B.Tech Programmes.", "trace_id": "d13f9a63", "latency_ms": 3633, "wall_ms": 3640, "client_wait_s": 0.0, "llm_calls": 2, "tokens": 1920, "fallback": false, "max_score": 0.755, "cache_hit": false, "cache_kind": "miss", "groundedness": 1.0, "guardrail": null, "degraded": false, "planner": "llm", "retrieval_mode": "hybrid+rerank", "rewrite": null, "standalone_question": null, "session_id": null, "retrieved": ["ACAD-REG-2024#7.3", "ACAD-2026-08#1", "ACAD-REG-2024#7.1", "ACAD-2026-08#2", "ACAD-REG-2024#7.4", "ACAD-REG-2024#7", "HELPD