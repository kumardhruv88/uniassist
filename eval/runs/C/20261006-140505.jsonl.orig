{"id": "PF7", "bucket": "policy_fact", "tags": ["paraphrase", "informal", "grading"], "difficulty": "easy", "question": "whats the pass mark for a course?", "student_id": null, "as_of_date": "2026-10-06", "session": null, "turn": null, "repeat_of": null, "expected_types": ["retrieved_fact"], "expected_answer_type": "retrieved_fact", "reference": "40% of the aggregate marks of the course (ACAD-REG-2024 \u00a78.2).", "expected_facts": ["40"], "expected_regex": [], "forbidden_facts": [], "expected_sources": ["ACAD-REG-2024#8.2"], "has_forbidden": false, "type_ok": true, "facts_ok": true, "forbidden_ok": true, "tool_ok": null, "citations": ["ACAD-REG-2024#8.2"], "cite_hits": 1, "cite_doc_hits": 1, "forbidden_sources_ok": true, "upcoming_ok": true, "conflict_ok": true, "meta_ok": null, "guardrail_ok": null, "correct": true, "reasons": [], "hallucination": false, "resisted": true, "retrieval_hit": true, "retrieval_hit_any": true, "retrieval_doc_hit": true, "retrieval_rank": 1, "answer_type": "retrieved_fact", "http_status": 200, "answer": "You need to secure a minimum of 40% of the aggregate marks of the course to pass.", "explanation": "You need to get at least 40% of the total marks in the course to pass. This is stated in the academic regulations for B.Tech programmes.", "trace_id": "dca330fa", "latency_ms": 3402, "wall_ms": 3408, "client_wait_s": 0.0, "llm_calls": 2, "tokens": 1690, "fallback": false, "max_score": 0.724, "cache_hit": false, "cache_kind": "miss", "groundedness": 1.0, "guardrail": null, "degraded": false, "planner": "llm", "retrieval_mode": "hybrid+rerank", "rewrite": null, "standalone_question": null, "session_id": null, "retrieved": ["ACAD-REG-2024#8.2", "ACAD-REG-2024#8.1", "ACAD-REG-2024#9.1", "ACAD-REG-2024#8.5", "ACAD-REG-2024#9.2", "ACAD-REG-2024#9.1", "ACAD-REG-2024#8.4", "ACAD-REG-2024#1.2", "ACAD-REG-2024#5.1", "ACAD-REG-2024#5.2"], "response": {"answer": "You need to secure a minimum of 40% of the aggregate marks of the course to pass.", "explanation": "You need to get at least 40% of the total marks in the course to pass. This is stated in the academic regulations for B.Tech programmes.", "citations": [{"doc_id": "ACAD-REG-2024", "section": "8.2", "title": "Academic Regulations for B.Tech Programmes", "version": "3.1", "effective_from": "2024-07-01"}], "tools": [{"tool": "get_rule", "input": {"parameter": "pass_min_total_pct"}, "output": {"scope": "B.Tech", "rule_id": "PASS-MIN-01", "operator": ">=", "value": "40", "source_doc_id": "ACAD-REG-2024", "source_section": "8.2"}, "status": "ok"}], "applied_rules": [{"rule_id": "PASS-MIN-01", "value": ">=40%", "source_doc_id": "ACAD-REG-2024", "source_section": "8.2", "parameter": "pass_min_total_pct"}], "conflicts": [], "upcoming": [], "clarification_options": [], "meta": {"cache_hit": false, "cache": "miss", "latency_ms": 3402, "guardrail": null, "output_redactions": [], "groundedness": 1.0, "session_id": null, "standalone_question": null, "rewrite": null, "degraded": false, "planner": "llm", "retrieval": "hybrid+rerank", "llm_calls": 2, "tokens": 1690, "tokens_saved": 0}}}
{"id": "PF8", "bucket": "policy_fact", "tags": ["paraphrase", "informal", "attendance", "version"], "difficulty": "medium", "question": "how much attendance is compulsory for end sems?", "student_id": null, "as_of_date": "2026-10-06", "session": null, "turn": null, "repeat_of": null, "expected_types": ["retrieved_fact"], "expected_answer_type": "retrieved_fact", "reference": "80% in each course (ACAD-2026-08 \u00a71, from 1 August 2026).", "expected_facts": ["80"], "expected_regex": [], "forbidden_facts": [], "expected_sources": ["ACAD-2026-08#1"], "has_forbidden": false, "type_ok": true, "facts_ok": true, "forbidden_ok": true, "tool_ok": null, "citations": ["ACAD-2026-08#1"], "cite_hits": 1, "cite_doc_hits": 1, "forbidden_sources_ok": true, "upcoming_ok": true, "conflict_ok": true, "meta_ok": null, "guardrail_ok": null, "correct": true, "reasons": [], "hallucination": false, "resisted": true, "retrieval_hit": true, "retrieval_hit_any": true, "retrieval_doc_hit": true, "retrieval_rank": 1, "answer_type": "retrieved_fact", "http_status": 200, "answer": "You need to attend at least 80% of the sessions to be eligible to appear in the end-semester examination.", "explanation": "You must attend at least 80% of the sessions to be eligible to appear in the end-semester examination, as per the revised minimum attendance requirement that came into effect from 1 August 2026.", "trace_id": "f94b61bc", "latency_ms": 3554, "wall_ms": 3561, "client_wait_s": 0.0, "llm_calls": 2, "tokens": 1781, "fallback": false, "max_score": 0.821, "cache_hit": false, "cache_kind": "miss", "groundedness": 1.0, "guardrail": null, "degraded": false, "planner": "llm", "retrieval_mode": "hybrid+rerank", "rewrite": null, "standalone_question": null, "session_id": null, "retrieved": ["ACAD-2026-08#1", "HELPDESK-FAQ-2026#3", "ACAD-REG-2024#7.1", "ACAD-REG-2024#7", "ACAD-2026-08#None", "ACAD-REG-2024#8.1", "ACAD-REG-2024#8.4", "HELPDESK-FAQ-2026#1", "ACAD-2026-08#3", "FEES-2026#1"], "response": {"answer": "You need to attend at least 80% of the sessions to be eligible to appear in the end-semester examination.", "explanation": "You must attend at least 80% of the sessions to be eligible to appear in the end-semester examination, as per the revised minimum attendance requirement that came into effect from 1 August 2026.", "citations": [{"doc_id": "ACAD-2026-08", "section": "1", "title": "Circular: Revised minimum attendance requirement", "version": "1", "effective_from": "2026-08-01"}], "tools": [{"tool": "get_rule", "input": {"parameter": "min_attendance_pct"}, "output": {"by_scope": [{"scope": "B.Tech", "rule_id": "AUTO-ACAD-2026-08-ATT-1", "operator": ">=", "value": "80", "source_doc_id": "ACAD-2026-08", "source_section": "1"}, {"scope": "other programmes", "rule_id": "AUTO-ACAD-2026-08-ATT-1", "operator": ">=", "value": "80", "source_doc_id": "ACAD-2026-08", "source_section": "1"}]}, "status": "ok"}], "applied_rules": [{"rule_id": "AUTO-ACAD-2026-08-ATT-1", "value": ">=80%", "source_doc_id": "ACAD-2026-08", "source_section": "1", "parameter": "min_attendance_pct"}], "conflicts": [{"topic": "min_attendance_pct", "winner": {"doc_id": "ACAD-2026-08", "section": "1", "value": "80", "title": "Circular: Revised minimum attendance requirement", "reason": null, "effective_from": "2026-08-01"}, "others": [{"doc_id": "ACAD-REG-2024", "section": "7.2", "value": "75", "title": "Academic Regulations for B.Tech Programmes", "reason": "replaced by ACAD-2026-08", "effective_from": "2024-07-01"}, {"doc_id": "HELPDESK-FAQ-2026", "section": "3", "value": "65", "title": "Student Help-desk FAQ 2026-27", "reason": "lower authority", "effective_from": "2026-09-15"}], "resolved_by": "step2_supersession"}, {"topic": "min_attendance_pct", "winner": {"doc_id": "ACAD-2026-08", "section": "1", "value": "80", "title": "Circular: Revised minimum attendance requirement", "reason": null, "effective_from": "2026-08-01"}, "others": [{"doc_id": "HELPDESK-FAQ-2026", "section": "3", "value": "65", "