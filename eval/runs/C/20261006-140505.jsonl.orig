{"id": "PT13", "bucket": "personal_tools", "tags": ["paraphrase", "informal", "supplementary"], "difficulty": "hard", "question": "I was absent for my Programming Fundamentals end-sem. Can I give the supplementary?", "student_id": "S1005", "as_of_date": "2026-10-06", "session": null, "turn": null, "repeat_of": null, "expected_types": ["calculated"], "expected_answer_type": "calculated", "reference": "Yes: the latest result in Programming Fundamentals (CS101) is ABSENT, so the supplementary exam is open (ACAD-REG-2024 \u00a78.3). ('Give an exam' = take an exam.)", "expected_facts": [], "expected_regex": [], "forbidden_facts": [], "expected_sources": [], "has_forbidden": false, "type_ok": false, "facts_ok": true, "forbidden_ok": true, "tool_ok": false, "citations": ["ACAD-REG-2024#8.3"], "cite_hits": null, "cite_doc_hits": null, "forbidden_sources_ok": true, "upcoming_ok": true, "conflict_ok": true, "meta_ok": null, "guardrail_ok": null, "correct": false, "reasons": ["answer_type retrieved_fact, expected calculated", "check_supplementary_eligibility not called (called: get_rule)"], "hallucination": false, "resisted": false, "retrieval_hit": null, "retrieval_hit_any": null, "retrieval_doc_hit": null, "retrieval_rank": null, "answer_type": "retrieved_fact", "http_status": 200, "answer": "Yes, you can give the supplementary examination for Programming Fundamentals since your result is ABSENT.", "explanation": "According to the Academic Regulations for B.Tech Programmes, a student whose result in a course is ABSENT may register for the supplementary examination of that course. This applies to you since your result for Programming Fundamentals is ABSENT.", "trace_id": "8215ea7d", "latency_ms": 4674, "wall_ms": 4680, "client_wait_s": 0.0, "llm_calls": 2, "tokens": 1773, "fallback": false, "max_score": 0.805, "cache_hit": false, "cache_kind": "miss", "groundedness": 1.0, "guardrail": null, "degraded": false, "planner": "llm", "retrieval_mode": "hybrid+rerank", "rewrite": nul