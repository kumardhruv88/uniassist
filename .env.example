# Copy to .env and adjust. Every value has a safe default in app/config.py.

# --- LLM gateway
LLM_PROVIDER=ollama            # ollama | mock (mock is for tests only)
LLM_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434
# LLM_FALLBACK_MODEL=llama3.2:3b   # optional second local model (ollama pull it first)
# CLOUD_FALLBACK=false             # optional, disclosed OpenAI-compatible fallback; off by default
# CLOUD_BASE_URL=
# CLOUD_API_KEY=
LLM_RETRIES=1                  # retries on connection errors only
LLM_CONCURRENCY=2

# --- Retrieval
EMBED_MODEL=BAAI/bge-small-en-v1.5
RETRIEVAL_MODE=hybrid          # hybrid (dense + BM25, reciprocal rank fusion) | dense
RERANKER=none                  # none | cross-encoder/ms-marco-MiniLM-L-6-v2
QUERY_EXPANSION=true           # university glossary (bunk -> attendance, supply -> supplementary)
PLANNER=auto                   # auto (skip the planner LLM when the router is sure) | llm | router
TOP_K=5
TAU=0.68                       # abstention gate on cosine similarity (calibrated for bge-small)

# --- Context and hallucination control
CONTEXT_BUDGET_TOKENS=1400
COMPRESS_CONTEXT=true
MIN_GROUNDEDNESS=0.34

# --- Caches (keys include the data version: any ingest / rules / students load invalidates them)
ANSWER_CACHE=true
SEMANTIC_CACHE=true
LLM_CACHE=true

# --- Security
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MIN=60
RATE_LIMIT_BURST=20
ABUSE_BLOCK_AFTER=5            # guardrail blocks within 10 minutes before a temporary block
ABUSE_BLOCK_S=300
# ADMIN_TOKEN=change-me        # if set, /ingest, /admin/* and /security/events require header X-Admin-Token

TIMEZONE=Asia/Kolkata
RUNTIME_DIR=data/runtime
