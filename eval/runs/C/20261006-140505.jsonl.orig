": "You are included in the policy because your batch number is 2023 or later. This means you can register for campus placements and follow the policy's rules.", "citations": [{"doc_id": "PLACE-POL-2025", "section": "1", "title": "Training and Placement Policy", "version": "2.0", "effective_from": "2025-06-01"}], "tools": [], "applied_rules": [], "conflicts": [], "upcoming": [], "clarification_options": [], "meta": {"cache_hit": false, "cache": "miss", "latency_ms": 3093, "guardrail": null, "output_redactions": [], "groundedness": 0.667, "session_id": null, "standalone_question": null, "rewrite": null, "degraded": false, "planner": "llm", "retrieval": "hybrid+rerank", "llm_calls": 2, "tokens": 1615, "tokens_saved": 0}}}
