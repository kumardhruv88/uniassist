{"id": "PF9", "bucket": "policy_fact", "tags": ["paraphrase", "placement"], "difficulty": "easy", "question": "What CGPA do I need for placements?", "student_id": null, "as_of_date": "2026-10-06", "session": null, "turn": null, "repeat_of": null, "expected_types": ["retrieved_fact"], "expected_answer_type": "retrieved_fact", "reference": "At least 6.5 CGPA, and no active backlogs when registering (PLACE-POL-2025 \u00a73).", "expected_facts": ["6.5"], "expected_regex": [], "forbidden_facts": [], "expected_sources": ["PLACE-POL-2025#3"], "has_forbidden": false, "type_ok": true, "facts_ok": true, "forbidden_ok": true, "tool_ok": null, "citations": ["PLACE-POL-2025#3"], "cite_hits": 1, "cite_doc_hits": 1, "forbidden_sources_ok": true, "upcoming_ok": true, "conflict_ok": true, "meta_ok": null, "guardrail_ok": null, "correct": true, "reasons": [], "hallucination": false, "resisted": true, "retrieval_hit": true, "retrieval_hit_any": true, "retrieval_doc_hit": true, "retrieval_rank": 1, "answer_type": "retrieved_fact", "http_status": 200, "answer": "You need a CGPA of at least 6.5 for placements.", "explanation": "You also need to have no active backlogs at the time of registration. This means you must have completed all your courses without any outstanding grades.", "trace_id": "a8bd086c", "latency_ms": 2933, "wall_ms": 2937, "client_wait_s": 0.0, "llm_calls": 2, "tokens": 1671, "fallback": false, "max_score": 0.895, "cache_hit": false, "cache_kind": "miss", "groundedness": 0.667, "guardrail": null, "degraded": false, "planner": "llm", "retrieval_mode": "hybrid+rerank", "rewrite": null, "standalone_question": null, "session_id": null, "retrieved": ["PLACE-POL-2025#3", "ACAD-REG-2024#9.2", "PLACE-POL-2025#2", "PLACE-POL-2025#4", "PLACE-POL-2025#1", "PLACE-POL-2025#5", "PLACE-POL-2025#None", "ACAD-REG-2024#5", "ACAD-REG-2024#5.1", "ACAD-REG-2024#10"], "response": {"answer": "You need a CGPA of at least 6.5 for placements.", "explanation": "You also need to have no active backlogs at the time of registration. This means you must have completed all your courses without any outstanding grades.", "citations": [{"doc_id": "PLACE-POL-2025", "section": "3", "title": "Training and Placement Policy", "version": "2.0", "effective_from": "2025-06-01"}], "tools": [{"tool": "get_rule", "input": {"parameter": "min_cgpa_placement"}, "output": {"scope": "all programmes", "rule_id": "PLC-CGPA-01", "operator": ">=", "value": "6.5", "source_doc_id": "PLACE-POL-2025", "source_section": "3"}, "status": "ok"}, {"tool": "get_rule", "input": {"parameter": "max_active_backlogs_placement"}, "output": {"scope": "all programmes", "rule_id": "PLC-BKLG-01", "operator": "<=", "value": "0", "source_doc_id": "PLACE-POL-2025", "source_section": "3"}, "status": "ok"}], "applied_rules": [{"rule_id": "PLC-CGPA-01", "value": ">=6.5", "source_doc_id": "PLACE-POL-2025", "source_section": "3", "parameter": "min_cgpa_placement"}, {"rule_id": "PLC-BKLG-01", "value": "<=0", "source_doc_id": "PLACE-POL-2025", "source_section": "3", "parameter": "max_active_backlogs_placement"}], "conflicts": [], "upcoming": [], "clarification_options": [], "meta": {"cache_hit": false, "cache": "miss", "latency_ms": 2933, "guardrail": null, "output_redactions": [], "groundedness": 0.667, "session_id": null, "standalone_question": null, "rewrite": null, "degraded": false, "planner": "llm", "retrieval": "hybrid+rerank", "llm_calls": 2, "tokens": 1671, "tokens_saved": 0}}}
{"id": "PF10", "bucket": "policy_fact", "tags": ["paraphrase", "grading"], "difficulty": "easy", "question": "How many marks is the end-semester exam worth in a theory course?", "student_id": null, "as_of_date": "2026-10-06", "session": null, "turn": null, "repeat_of": null, "expected_types": ["retrieved_fact"], "expected_answer_type": "retrieved_fact", "reference": "60 of the 100 marks; the other 40 are internal assessment (ACAD-REG-2024 \u00a78.1).", "expected_facts": ["60"], "expected_regex": [], "forbidden_facts": [], "expected_sources": ["ACAD-REG-2024#8.1"], "has_forbidden": false, "type_ok": true, "facts_ok": true, "forbidden_ok": true, "tool_ok": null, "citations": ["ACAD-REG-2024#8.1"], "cite_hits": 1, "cite_doc_hits": 1, "forbidden_sources_ok": true, "upcoming_ok": true, "conflict_ok": true, "meta_ok": null, "guardrail_ok": null, "correct": true, "reasons": [], "hallucination": false, "resisted": true, "retrieval_hit": true, "retrieval_hit_any": true, "retrieval_doc_hit": true, "retrieval_rank": 2, "answer_type": "retrieved_fact", "http_status": 200, "answer": "The end-semester exam is worth 60 marks in a theory course.", "explanation": "You can find this information in the Academic Regulations for B.Tech Programmes, section 8.1. According to this, each theory course is evaluated out of 100 marks, with 60 marks in the end-semester examination.", "trace_id": "ed46df06", "latency_ms": 3462, "wall_ms": 3465, "client_wait_s": 0.0, "llm_calls": 2, "tokens": 1742, "fallback": false, "max_score": 0.807, "cache_hit": false, "cache_kind": "miss", "groundedness": 1.0, "guardrail": null, "degraded": false, "planner": "llm", "retrieval_mode": "hybrid+rerank", "rewrite": null, "standalone_question": null, "session_id": null, "retrieved": ["ACAD-REG-2024#8.2", "ACAD-REG-2024#8.1", "ACAD-REG-2024#8.4", "ACAD-2026-08#1", "ACAD-REG-2024#1.2", "ACAD-REG-2024#9.1", "HELPDESK-FAQ-2026#1", "EXAM-SUPP-2025#4", "ACAD-REG-2024#5.1", "FEES-2026#1"], "response": {"answer": "The end-semester exam is worth 60 marks in a theory course.", "explanation": "You can find this information in the Academic Regulations for B.Tech Programmes, section 8.1. According to this, each theory course is evaluated out of 100 marks, with 60 marks in the end-semester examination.", "citations": [{"doc_id": "ACAD-REG-2024", "section": "8.1", "title": "Academic Regulations for B.Tech Programmes", "version": "3.1", "effective_from": "2024-07-01"}], "tools": [{"tool": "get_rule", "input": {"parameter": "pass_min_total_pct"}, "output": {"scope": "B.Tech", "rule_id": "PASS-MIN-01", "operator": ">=", "value": "40", "source_doc_id": "ACAD-REG-2024", "source_section": "8.2"}, "status": "ok"}], "applied_rules": [{"rule_id": "PASS-MIN-01", "value": ">=40%", "source_doc_id": "ACAD-REG-2024", "source_section": "8.2", "parameter": "pass_min_total_pct"}], "conflicts": [], "upcoming": [], "clarification_options": [], "meta": {"cache_hit": false, "cache": "miss", "latency_ms": 3462, "guardrail": null, "output_redactions": [], "groundedness": 1.0, "session_id": null, "standalone_question": null, "rewrite": null, "degraded": false, "planner": "llm", "retrieval": "hybrid+rerank", "llm_calls": 2, "tokens": 1742, "tokens_saved": 0}}}
{"id": "PF11", "bucket": "policy_fact", "tags": ["placement"], "difficulty": "easy", "question": "What happens if a student registers for a placement drive and is absent without informing the placement office?", "student_id": null, "as_of_date": "2026-10-06", "session": null, "turn": null, "repeat_of": null, "expected_types": ["retrieved_fact"], "expected_answer_type": "retrieved_fact", "reference": "The student is barred from the next two placement drives (PLACE-POL-2025 \u00a75).", "expected_facts": [], "expected_regex": ["(?:two|2) (?:placement )?drives|next two"], "forbidden_facts": [], "expected_sources": ["PLACE-POL-2025#5"], "has_forbidden": false, "type_ok": true, "facts_ok": true, "forbidden_ok": true, "tool_ok": null, "citations": ["PLACE-POL-2025#5"], "cite_hits": 1, "cite_doc_hits": 1, "forbidden_sources_ok": true, "upcoming_ok": true, "conflict_ok": true, "meta_ok": null, "guardrail_ok": null, "correct": true, "reasons": [], "hallucination": false, "resisted": true, "retrieval_hit": true, "retrieval_hit_any": true, "retrieval_doc_hit": true, "retrieval_rank": 2, "answer_type": "retrieved_fact", "http_status": 200, "answer": "If you register for a placement drive and are absent without informing the placement office, you will be barred from the next two drives.", "explanation": "You will not be allowed to participate in the placement drives for the next two drives as a consequence of your absence without notice.", "trace_id": "ddc30036", "latency_ms": 3220, "wall_ms": 3226, "client_wait_s": 0.0, "llm_calls": 2, "tokens": 1766, "fallback": false, "max_score": 0.754, "cache_hit": false, "cache_kind": "miss", "groundedness": 1.0, "guardrail": null, "degraded": false, "planner": "llm", "retrieval_mode": "hybrid+rerank", "rewrite": null, "standalone_question": null, "session_id": null, "retrieved": ["PLACE-POL-2025#3", "PLACE-POL-2025#5", "PLACE-POL-2025#4", "PLACE-POL-2025#2", "ACAD-REG-2024#8.3", "PLACE-POL-2025#1", "ACAD-REG-2024#5.1", "ACAD-REG-2024#7.4", "ACAD-REG-2024#8.5", "PLACE-POL-2025#None"], "response": {"answer": "If you register for a placement drive and are absent without informing the placement office, you will be barred from the next two drives.", "explanation": "You will not be allowed to participate in the placement drives for the next two drives as a consequence of your absence without notice.", "citations": [{"doc_id": "PLACE-POL-2025", "section": "5", "title": "Training and Placement Policy", "version": "2.0", "effective_from": "2025-06-01"}], "tools": [{"tool": "get_rule", "input": {"parameter": "min_cgpa_placement"}, "output": {"scope": "all programmes", "rule_id": "PLC-CGPA-01", "operator": ">=", "value": "6.5", "source_doc_id": "PLACE-POL-2025", "source_section": "3"}, "status": "ok"}, {"tool": "get_rule", "input": {"parameter": "max_active_backlogs_placement"}, "output": {"scope": "all programmes", "rule_id": "PLC-BKLG-01", "operator": "<=", "value": "0", "source_doc_id": "PLACE-POL-2025", "source_section": "3"}, "status": "ok"}], "applied_rules": [{"rule_id": "PLC-CGPA-01", "value": ">=6.5", "source_doc_id": "PLACE-POL-2025", "source_section": "3", "parameter": "min_cgpa_placement"}, {"rule_id": "PLC-BKLG-01", "value": "<=0", "source_doc_id": "PLACE-POL-2025", "source_section": "3", "parameter": "max_active_backlogs_placement"}], "conflicts": [], "upcoming": [], "clarification_options": [], "meta": {"cache_hit": false, "cache": "miss", "latency_ms": 3220, "guardrail": null, "output_redactions": [], "groundedness": 1.0, "session_id": null, "standalone_question": null, "rewrite": null, "degraded": false, "planner": "llm", "retrieval": "hybrid+rerank", "llm_calls": 2, "tokens": 1766, "tokens_saved": 0}}}
{"id": "PF12", "bucket": "policy_fact", "tags": ["placement"], "difficulty": "medium", "question": "Can a student who has accepted a placement offer sit for more placement drives?", "student_id": null, "as_of_date": "2026-10-06", "session": null, "turn": null, "repeat_of": null, "expected_types": ["retrieved_fact"], "expected_answer_type": "retrieved_fact", "reference": "No, except for offers of at least 1.5 times the accepted package (one-offer rule, PLACE-POL-2025 \u00a74).", "expected_facts": ["1.5"], "expected_regex": [], "forbidden_facts": [], "expected_sources": ["PLACE-POL-2025#4"], "has_forbidden": false, "type_ok": true, "facts_ok": false, "forbidden_ok": true, "tool_ok": null, "citations": ["PLACE-POL-2025#4"], "cite_hits": 1, "cite_doc_hits": 1, "forbidden_sources_ok": true, "upcoming_ok": true, "conflict_ok": true, "meta_ok": null, "guardrail_ok": null, "correct": false, "reasons": ["missing 1.5"], "hallucination": false, "resisted": true, "retrieval_hit": true, "retrieval_hit_any": true, "retrieval_doc_hit": true, "retrieval_rank": 2, "answer_type": "retrieved_fact", "http_status": 200, "answer": "No, you cannot sit for more placement drives after accepting a placement offer.", "explanation": "You accepted a placement offer, which means you are no longer eligible for further placement drives, according to the One offer rule in the Training and Placement Policy.", "trace_id": "f47b6c78", "latency_ms": 6220, "wall_ms": 6223, "client_wait_s": 0.0, "llm_calls": 3, "tokens": 2783, "fallback": false, "max_score": 0.814, "cache_hit": false, "cache_kind": "miss", "groundedness": 1.0, "guardrail": null, "degraded": false, "planner": "llm", "retrieval_mode": "hybrid+rerank", "rewrite": null, "standalone_question": null, "session_id": null, "retrieved": ["PLACE-POL-2025#3", "PLACE-POL-2025#4", "PLACE-POL-2025#5", "PLACE-POL-2025#1", "PLACE-POL-2025#2", "PLACE-POL-2025#None", "ACAD-REG-2024#5.2", "ACAD-REG-2024#8.3", "ACAD-REG-2024#5.1", "EXAM-SUPP-2025#2"], "respo