{"id": "PF1", "bucket": "policy_fact", "tags": ["attendance", "version", "supersession"], "difficulty": "medium", "question": "What is the minimum attendance required to appear in end-semester exams?", "student_id": null, "as_of_date": "2026-10-06", "session": null, "turn": null, "repeat_of": null, "expected_types": ["retrieved_fact"], "expected_answer_type": "retrieved_fact", "reference": "80% attendance in each course (circular ACAD-2026-08 \u00a71, in force from 1 August 2026; it replaced the 75% rule in ACAD-REG-2024 \u00a77.2).", "expected_facts": ["80"], "expected_regex": [], "forbidden_facts": [], "expected_sources": ["ACAD-2026-08#1"], "has_forbidden": false, "type_ok": true, "facts_ok": true, "forbidden_ok": true, "tool_ok": null, "citations": ["ACAD-2026-08#1"], "cite_hits": 1, "cite_doc_hits": 1, "forbidden_sources_ok": true, "upcoming_ok": true, "conflict_ok": true, "meta_ok": null, "guardrail_ok": null, "correct": true, "reasons": [], "hallucination": false, "resisted": true, "retrieval_hit": true, "retrieval_hit_any": true, "retrieval_doc_hit": true, "retrieval_rank": 1, "answer_type": "retrieved_fact", "http_status": 200, "answer": "The minimum attendance required to appear in end-semester exams is 80%. This applies to all courses, including B.Tech.", "explanation": "You need to have at least 80% attendance to be eligible to take the end-semester exams. This rule applies to all courses, including B.Tech, as stated in the circular.", "trace_id": "14d19715", "latency_ms": 7936, "wall_ms": 7947, "client_wait_s": 0.0, "llm_calls": 2, "tokens": 1771, "fallback": false, "max_score": 0.837, "cache_hit": false, "cache_kind": "miss", "groundedness": 0.75, "guardrail": null, "degraded": false, "planner": "llm", "retrieval_mode": "hybrid+rerank", "rewrite": null, "standalone_question": null, "session_id": null, "retrieved": ["ACAD-2026-08#1", "HELPDESK-FAQ-2026#3", "ACAD-REG-2024#8.1", "ACAD-REG-2024#8.4", "ACAD-REG-2024#7", "HELPDESK-FAQ-2026#1", "ACAD-2026-08#