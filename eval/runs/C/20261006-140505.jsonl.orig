{"id": "PF21", "bucket": "policy_fact", "tags": ["attendance", "definitions"], "difficulty": "medium", "question": "How is attendance percentage calculated?", "student_id": null, "as_of_date": "2026-10-06", "session": null, "turn": null, "repeat_of": null, "expected_types": ["retrieved_fact"], "expected_answer_type": "retrieved_fact", "reference": "Sessions attended divided by sessions held in the course; attendance is recorded for every lecture, tutorial and laboratory session (ACAD-REG-2024 \u00a77.1).", "expected_facts": [], "expected_regex": ["attended", "held"], "forbidden_facts": [], "expected_sources": ["ACAD-REG-2024#7.1"], "has_forbidden": false, "type_ok": true, "facts_ok": true, "forbidden_ok": true, "tool_ok": null, "citations": ["ACAD-REG-2024#7.1"], "cite_hits": 1, "cite_doc_hits": 1, "forbidden_sources_ok": true, "upcoming_ok": true, "conflict_ok": true, "meta_ok": null, "guardrail_ok": null, "correct": true, "reasons": [], "hallucination": false, "resisted": true, "retrieval_hit": true, "retrieval_hit_any": true, "retrieval_doc_hit": true, "retrieval_rank": 2, "answer_type": "retrieved_fact", "http_status": 200, "answer": "Attendance percentage is calculated as the number of sessions attended divided by the number of sessions held in the course.", "explanation": "You can find this information in the Academic Regulations for B.Tech Programmes, section 7.1. This is the official way to calculate attendance percentage.", "trace_id": "b80580fa", "latency_ms": 3198, "wall_ms": 3203, "client_wait_s": 0.0, "llm_calls": 2, "tokens": 1778, "fallback": false, "max_score": 0.743, "cache_hit": false, "cache_kind": "miss", "groundedness": 1.0, "guardrail": null, "degraded": false, "planner": "llm", "retrieval_mode": "hybrid+rerank", "rewrite": null, "standalone_question": null, "session_id": null, "retrieved": ["ACAD-2026-08#1", "ACAD-REG-2024#7.1", "ACAD-REG-2024#7", "HELPDESK-FAQ-2026#3", "ACAD-REG-2024#7.3", "ACAD-2026-08#3", "SC-POST-2026#None", "ACAD-REG-2024