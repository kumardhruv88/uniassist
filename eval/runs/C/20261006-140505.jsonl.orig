{"id": "PT2", "bucket": "personal_tools", "tags": ["attendance"], "difficulty": "medium", "question": "Can I sit the Data Structures end-semester exam?", "student_id": "S1003", "as_of_date": "2026-07-15", "session": null, "turn": null, "repeat_of": null, "expected_types": ["calculated"], "expected_answer_type": "calculated", "reference": "No: 29/40 = 72.50% is below 75%; attending the next 4 classes gives 33/44 = 75%.", "expected_facts": [], "expected_regex": [], "forbidden_facts": [], "expected_sources": [], "has_forbidden": false, "type_ok": true, "facts_ok": true, "forbidden_ok": true, "tool_ok": true, "citations": ["ACAD-REG-2024#7.2"], "cite_hits": null, "cite_doc_hits": null, "forbidden_sources_ok": true, "upcoming_ok": true, "conflict_ok": true, "meta_ok": null, "guardrail_ok": null, "correct": true, "reasons": [], "hallucination": false, "resisted": true, "retrieval_hit": null, "retrieval_hit_any": null, "retrieval_doc_hit": null, "retrieval_rank": null, "answer_type": "calculated", "http_status": 200, "answer": "You are not eligible to sit the Data Structures (CS201) end-semester exam: your attendance is 72.50%, below the required 75%. Attending the next 4 classes would bring you to 33 of 44.", "explanation": "According to the Academic Regulations for B.Tech Programmes, you need at least 75% attendance to be eligible to sit the end-semester exam. Unfortunately, your current attendance is 72.50%, which is below the threshold.", "trace_id": "662e8314", "latency_ms": 3234, "wall_ms": 3240, "client_wait_s": 0.0, "llm_calls": 1, "tokens": 1137, "fallback": false, "max_score": 0.687, "cache_hit": false, "cache_kind": "miss", "groundedness": 1.0, "guardrail": null, "degraded": false, "planner": "router_first", "retrieval_mode": "hybrid+rerank", "rewrite": null, "standalone_question": null, "session_id": null, "retrieved": ["ACAD-REG-2024#7.2", "ACAD-REG-2024#8.4", "ACAD-REG-2024#8.1", "ACAD-REG-2024#5.1", "EXAM-SUPP-2025#4", "ACAD-REG-2024#8", "ACAD-REG-2024#1.2", "ACAD-REG-2024#8.3", "EXAM-SUPP-2025#5", "FEES-2026#None"], "response": {"answer": "You are not eligible to sit the Data Structures (CS201) end-semester exam: your attendance is 72.50%, below the required 75%. Attending the next 4 classes would bring you to 33 of 44.", "explanation": "According to the Academic Regulations for B.Tech Programmes, you need at least 75% attendance to be eligible to sit the end-semester exam. Unfortunately, your current attendance is 72.50%, which is below the threshold.", "citations": [{"doc_id": "ACAD-REG-2024", "section": "7.2", "title": "Academic Regulations for B.Tech Programmes", "version": "3.1", "effective_from": "2024-07-01"}], "tools": [{"tool": "check_exam_eligibility", "input": {"course_code": "CS201"}, "output": {"result": "NOT_ELIGIBLE", "classes_held": 40, "classes_attended": 29, "attendance_pct": 72.5, "threshold": 75.0, "rule_id": "ATT-MIN-01", "classes_needed": 4, "projected_attended": 33, "projected_held": 44}, "status": "ok"}], "applied_rules": [{"rule_id": "ATT-MIN-01", "value": ">=75%", "source_doc_id": "ACAD-REG-2024", "source_section": "7.2", "parameter": "min_attendance_pct"}], "conflicts": [], "upcoming": ["ACAD-2026-08"], "clarification_options": [], "meta": {"cache_hit": false, "cache": "miss", "latency_ms": 3234, "guardrail": null, "output_redactions": [], "groundedness": 1.0, "session_id": null, "standalone_question": null, "rewrite": null, "degraded": false, "planner": "router_first", "retrieval": "hybrid+rerank", "llm_calls": 1, "tokens": 1137, "tokens_saved": 0}}}
