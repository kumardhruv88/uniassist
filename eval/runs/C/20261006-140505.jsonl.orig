{"id": "PT14", "bucket": "personal_tools", "tags": ["ece", "supplementary"], "difficulty": "medium", "question": "Can I register for the Signals and Systems supplementary exam?", "student_id": "S1031", "as_of_date": "2026-10-06", "session": null, "turn": null, "repeat_of": null, "expected_types": ["calculated"], "expected_answer_type": "calculated", "reference": "No: the latest result in Signals and Systems (EC201) is DETAINED; re-register for the course instead (ACAD-REG-2024 \u00a78.3, \u00a75.2).", "expected_facts": [], "expected_regex": [], "forbidden_facts": [], "expected_sources": [], "has_forbidden": false, "type_ok": true, "facts_ok": true, "forbidden_ok": true, "tool_ok": true, "citations": ["ACAD-REG-2024#8.3"], "cite_hits": null, "cite_doc_hits": null, "forbidden_sources_ok": true, "upcoming_ok": true, "conflict_ok": true, "meta_ok": null, "guardrail_ok": null, "correct": true, "reasons": [], "hallucination": false, "resisted": true, "retrieval_hit": null, "retrieval_hit_any": null, "retrieval_doc_hit": null, "retrieval_rank": null, "answer_type": "calculated", "http_status": 200, "answer": "You cannot register for the Signals and Systems (EC201) supplementary exam: your latest result is DETAINED, and only FAIL or ABSENT results may register.", "explanation": "According to the Academic Regulations for B.Tech Programmes, a student who is DETAINED is not eligible for the supplementary examination. Your latest result is DETAINED, so you do not meet the eligibility criteria.", "trace_id": "e6c93385", "latency_ms": 4014, "wall_ms": 4018, "client_wait_s": 0.0, "llm_calls": 2, "tokens": 1892, "fallback": false, "max_score": 0.773, "cache_hit": false, "cache_kind": "miss", "groundedness": 1.0, "guardrail": null, "degraded": false, "planner": "llm", "retrieval_mode": "hybrid+rerank", "rewrite": null, "standalone_question": null, "session_id": null, "retrieved": ["ACAD-REG-2024#8.3", "EXAM-SUPP-2025#1", "EXAM-SUPP-2025#2", "ACAD-REG-2024#8.4", "EXAM-SUPP-2025#5", "ACAD-REG-2024#5", "EXAM-SUPP-2025#None", "EXAM-SUPP-2025#4", "EXAM-SUPP-2025#3", "ACAD-REG-2024#5.1"], "response": {"answer": "You cannot register for the Signals and Systems (EC201) supplementary exam: your latest result is DETAINED, and only FAIL or ABSENT results may register.", "explanation": "According to the Academic Regulations for B.Tech Programmes, a student who is DETAINED is not eligible for the supplementary examination. Your latest result is DETAINED, so you do not meet the eligibility criteria.", "citations": [{"doc_id": "ACAD-REG-2024", "section": "8.3", "title": "Academic Regulations for B.Tech Programmes", "version": "3.1", "effective_from": "2024-07-01"}], "tools": [{"tool": "check_supplementary_eligibility", "input": {"course_code": "EC201"}, "output": {"result": "NOT_ELIGIBLE", "latest_result": "DETAINED", "allowed_results": ["FAIL", "ABSENT"], "rule_id": "SUPP-ELIG-01"}, "status": "ok"}], "applied_rules": [{"rule_id": "SUPP-ELIG-01", "value": "inFAIL;ABSENT", "source_doc_id": "ACAD-REG-2024", "source_section": "8.3", "parameter": "supplementary_allowed_results"}], "conflicts": [], "upcoming": [], "clarification_options": [], "meta": {"cache_hit": false, "cache": "miss", "latency_ms": 4014, "guardrail": null, "output_redactions": [], "groundedness": 1.0, "session_id": null, "standalone_question": null, "rewrite": null, "degraded": false, "planner": "llm", "retrieval": "hybrid+rerank", "llm_calls": 2, "tokens": 1892, "tokens_saved": 63}}}
{"id": "PT15", "bucket": "personal_tools", "tags": ["placement", "backlogs"], "difficulty": "easy", "question": "Am I eligible for campus placements?", "student_id": "S1011", "as_of_date": "2026-10-06", "session": null, "turn": null, "repeat_of": null, "expected_types": ["calculated"], "expected_answer_type": "calculated", "reference": "No: CGPA 6.90 is fine but there are 3 active backlogs (CS201, CS202, MA201) and the policy allows none (PLACE-POL-2025 \u00a73).", "expected_facts": [], "expected_regex": [], "forbidden_facts": [], "expected_sources": [], "has_forbidden": false, "type_ok": true, "facts_ok": true, "forbidden_ok": true, "tool_ok": true, "citations": ["PLACE-POL-2025#3"], "cite_hits": null, "cite_doc_hits": null, "forbidden_sources_ok": true, "upcoming_ok": true, "conflict_ok": true, "meta_ok": null, "guardrail_ok": null, "correct": true, "reasons": [], "hallucination": false, "resisted": true, "retrieval_hit": null, "retrieval_hit_any": null, "retrieval_doc_hit": null, "retrieval_rank": null, "answer_type": "calculated", "http_status": 200, "answer": "You are not yet eligible for placements: 3 active backlogs (CS201, CS202, MA201) exceed the maximum of 0.", "explanation": "You have 3 active backlogs in CS201, CS202, and MA201, which exceeds the maximum allowed. According to the Training and Placement Policy, you must have no active backlogs to be eligible for placements.", "trace_id": "06aa90f0", "latency_ms": 2874, "wall_ms": 2878, "client_wait_s": 0.0, "llm_calls": 1, "tokens": 1067, "fallback": false, "max_score": 0.795, "cache_hit": false, "cache_kind": "miss", "groundedness": 1.0, "guardrail": null, "degraded": false, "planner": "router_first", "retrieval_mode": "hybrid+rerank", "rewrite": null, "standalone_question": null, "session_id": null, "retrieved": ["PLACE-POL-2025#3", "PLACE-POL-2025#1", "PLACE-POL-2025#4", "PLACE-POL-2025#2", "EXAM-SUPP-2025#1", "PLACE-POL-2025#5", "EXAM-SUPP-2025#2", "PLACE-POL-2025#None", "ACAD-REG-2024#5.1", "ACAD-REG-2024#8.3"], "response": {"answer": "You are not yet eligible for placements: 3 active backlogs (CS201, CS202, MA201) exceed the maximum of 0.", "explanation": "You have 3 active backlogs in CS201, CS202, and MA201, which exceeds the maximum allowed. According to the Training and Placement Policy, you must have no active backlogs to be eligible for placements.", "citations": [{"doc_id": "PLACE-POL-2025", "section": "3", "title": "Training and Placement Policy", "version": "2.0", "effective_from": "2025-06-01"}], "tools": [{"tool": "check_placement_eligibility", "input": {"assume_cleared": [], "assume_cgpa": null}, "output": {"result": "NOT_ELIGIBLE", "cgpa": 6.9, "active_backlogs": 3, "assumptions_applied": [], "backlog_courses": ["CS201", "CS202", "MA201"], "min_cgpa": 6.5, "max_backlogs": 0, "rule_ids": ["PLC-CGPA-01", "PLC-BKLG-01"]}, "status": "ok"}], "applied_rules": [{"rule_id": "PLC-CGPA-01", "value": ">=6.5", "source_doc_id": "PLACE-POL-2025", "source_section": "3", "parameter": "min_cgpa_placement"}, {"rule_id": "PLC-BKLG-01", "value": "<=0", "source_doc_id": "PLACE-POL-2025", "source_section": "3", "parameter": "max_active_backlogs_placement"}], "conflicts": [], "upcoming": [], "clarification_options": [], "meta": {"cache_hit": false, "cache": "miss", "latency_ms": 2874, "guardrail": null, "output_redactions": [], "groundedness": 1.0, "session_id": null, "standalone_question": null, "rewrite": null, "degraded": false, "planner": "router_first", "retrieval": "hybrid+rerank", "llm_calls": 1, "tokens": 1067, "tokens_saved": 63}}}
