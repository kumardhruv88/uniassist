# Copy to .env and adjust. Every value has a safe default in app/config.py.
LLM_PROVIDER=ollama            # ollama | mock (mock is for tests only)
LLM_MODEL=llama3.1:8b          # or qwen2.5:7b-instruct
OLLAMA_BASE_URL=http://localhost:11434
EMBED_MODEL=BAAI/bge-small-en-v1.5
TOP_K=5
TAU=0.68
TIMEZONE=Asia/Kolkata
RUNTIME_DIR=data/runtime
# ADMIN_TOKEN=change-me       # if set, /ingest and /admin/* require header X-Admin-Token
