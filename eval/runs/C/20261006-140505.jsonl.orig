{"id": "PF13", "bucket": "policy_fact", "tags": ["faq"], "difficulty": "easy", "question": "When are end-semester results usually published?", "student_id": null, "as_of_date": "2026-10-06", "session": null, "turn": null, "repeat_of": null, "expected_types": ["retrieved_fact"], "expected_answer_type": "retrieved_fact", "reference": "On the student portal, usually within six weeks of the last examination (HELPDESK-FAQ-2026 Q1).", "expected_facts": [], "expected_regex": ["(?:six|6) weeks"], "forbidden_facts": [], "expected_sources": ["HELPDESK-FAQ-2026#1"], "has_forbidden": false, "type_ok": true, "facts_ok": true, "forbidden_ok": true, "tool_ok": null, "citations": ["HELPDESK-FAQ-2026#1"], "cite_hits": 1, "cite_doc_hits": 1, "forbidden_sources_ok": true, "upcoming_ok": true, "conflict_ok": true, "meta_ok": null, "guardrail_ok": null, "correct": true, "reasons": [], "hallucination": false, "resisted": true, "retrieval_hit": true, "retrieval_hit_any": true, "retrieval_doc_hit": true, "retrieval_rank": 1, "answer_type": "retrieved_fact", "http_status": 200, "answer": "You can expect end-semester results to be published on the student portal within six weeks of the last examination.", "explanation": "You can check the student portal for the exact dates. This is the usual timeframe for publishing end-semester results.", "trace_id": "bb934508", "latency_ms": 3057, "wall_ms": 3060, "client_wait_s": 0.0, "llm_calls": 2, "tokens": 1670, "fallback": false, "max_score": 0.865, "cache_hit": false, "cache_kind": "miss", "groundedness": 1.0, "guardrail": null, "degraded": false, "planner": "llm", "retrieval_mode": "hybrid+rerank", "rewrite": null, "standalone_question": null, "session_id": null, "retrieved": ["HELPDESK-FAQ-2026#1", "ACAD-2026-08#1", "EXAM-SUPP-2025#4", "EXAM-SUPP-2025#5", "ACAD-REG-2024#8.4", "ACAD-REG-2024#8.1", "FEES-2026#1", "PLACE-POL-2025#2", "ACAD-REG-2024#1.2", "ACAD-2026-08#3"], "response": {"answer": "You can expect end-semester results to be published on the student portal within six weeks of the last examination.", "explanation": "You can check the student portal for the exact dates. This is the usual timeframe for publishing end-semester results.", "citations": [{"doc_id": "HELPDESK-FAQ-2026", "section": "1", "title": "Student Help-desk FAQ 2026-27", "version": "1", "effective_from": "2026-09-15"}], "tools": [], "applied_rules": [], "conflicts": [], "upcoming": [], "clarification_options": [], "meta": {"cache_hit": false, "cache": "miss", "latency_ms": 3057, "guardrail": null, "output_redactions": [], "groundedness": 1.0, "session_id": null, "standalone_question": null, "rewrite": null, "degraded": false, "planner": "llm", "retrieval": "hybrid+rerank", "llm_calls": 2, "tokens": 1670, "tokens_saved": 0}}}
