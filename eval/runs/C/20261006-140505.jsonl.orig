{"id": "NA9", "bucket": "unanswerable", "tags": ["abstain", "near_miss"], "difficulty": "medium", "question": "Is there a scholarship for students with a CGPA above 9?", "student_id": null, "as_of_date": "2026-10-06", "session": null, "turn": null, "repeat_of": null, "expected_types": ["not_found"], "expected_answer_type": "not_found", "reference": "I could not find this information in the authorised university sources (no scholarship document).", "expected_facts": [], "expected_regex": [], "forbidden_facts": [], "expected_sources": [], "has_forbidden": false, "type_ok": false, "facts_ok": true, "forbidden_ok": true, "tool_ok": null, "citations": ["ACAD-REG-2024#9.2", "PLACE-POL-2025#3", "ACAD-REG-2024#9.1"], "cite_hits": null, "cite_doc_hits": null, "forbidden_sources_ok": true, "upcoming_ok": true, "conflict_ok": true, "meta_ok": null, "guardrail_ok": null, "correct": false, "reasons": ["answer_type retrieved_fact, expected not_found"], "hallucination": true, "resisted": false, "retrieval_hit": null, "retrieval_hit_any": null, "retrieval_doc_hit": null, "retrieval_rank": null, "answer_type": "retrieved_fact", "http_status": 200, "answer": "There is no scholarship for students with a CGPA above 9. The regulations mention eligibility criteria for campus placements and pass criteria, but do not mention any scholarship.", "explanation": "You can see that the CGPA is calculated based on the grade points, but there is no mention of a scholarship for students with a CGPA above 9. The eligibility criteria for campus placements and pass criteria are mentioned, but they do not relate to a scholarship.", "trace_id": "b8799e4e", "latency_ms": 4202, "wall_ms": 4205, "client_wait_s": 0.0, "llm_calls": 2, "tokens": 1747, "fallback": false, "max_score": 0.716, "cache_hit": false, "cache_kind": "miss", "groundedness": 0.5, "guardrail": null, "degraded": false, "planner": "llm", "retrieval_mode": "hybrid+rerank", "rewrite": null, "standalone_question": null, "session_id": null, "re