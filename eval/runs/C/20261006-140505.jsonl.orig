d": "HELPDESK-FAQ-2026", "section": "3", "value": "65", "title": "Student Help-desk FAQ 2026-27", "reason": "lower authority", "effective_from": "2026-09-15"}], "resolved_by": "step2_supersession"}], "upcoming": [], "clarification_options": [], "meta": {"cache_hit": false, "cache": "miss", "latency_ms": 2664, "guardrail": null, "output_redactions": [], "groundedness": 1.0, "session_id": null, "standalone_question": null, "rewrite": null, "degraded": false, "planner": "router_first", "retrieval": "hybrid+rerank", "llm_calls": 1, "tokens": 1183, "tokens_saved": 41}}}
{"id": "CD5", "bucket": "policy_fact", "tags": ["what_if", "attendance"], "difficulty": "easy", "question": "Is 85% attendance enough to appear for the end-semester exam?", "student_id": null, "as_of_date": "2026-10-06", "session": null, "turn": null, "repeat_of": null, "expected_types": ["retrieved_fact"], "expected_answer_type": "retrieved_fact", "reference": "Yes: 85% meets the 80% minimum (ACAD-2026-08 \u00a71).", "expected_facts": ["80"], "expected_regex": [], "forbidden_facts": [], "expected_sources": ["ACAD-2026-08#1"], "has_forbidden": false, "type_ok": true, "facts_ok": true, "forbidden_ok": true, "tool_ok": true, "citations": ["ACAD-2026-08#1"], "cite_hits": 1, "cite_doc_hits": 1, "forbidden_sources_ok": true, "upcoming_ok": true, "conflict_ok": true, "meta_ok": null, "guardrail_ok": null, "correct": true, "reasons": [], "hallucination": false, "resisted": true, "retrieval_hit": true, "retrieval_hit_any": true, "retrieval_doc_hit": true, "retrieval_rank": 1, "answer_type": "retrieved_fact", "http_status": 200, "answer": "Yes: 85% attendance meets the 80% minimum required to sit the end-semester exam.", "explanation": "You meet the minimum attendance requirement of 80% as stated in the circular. This means you are eligible to sit for the end-semester exam.", "trace_id": "e35b7edf", "latency_ms": 2530, "wall_ms": 2537, "client_wait_s": 0.0, "llm_calls": 1, "tokens": 1057, "fallback": false, "max_score": 0.786, "cache_hit": false, "cache_kind": "miss", "groundedness": 1.0, "guardrail": null, "degraded": false, "planner": "router_first", "retrieval_mode": "hybrid+rerank", "rewrite": null, "standalone_question": null, "session_id": null, "retrieved": ["ACAD-2026-08#1", "HELPDESK-FAQ-2026#3", "ACAD-REG-2024#8.4", "ACAD-REG-2024#8.1", "HELPDESK-FAQ-2026#1", "ACAD-REG-2024#7.1", "ACAD-REG-2024#7", "EXAM-SUPP-2025#4", "ACAD-2026-08#None", "FEES-2026#1"], "response": {"answer": "Yes: 85% attendance meets the 80% minimum required to sit the end-semester exam.", "explanation": "You meet the minimum attendance requirement of 80% as stated in the circular. This means you are eligible to sit for the end-semester exam.", "citations": [{"doc_id": "ACAD-2026-08", "section": "1", "title": "Circular: Revised minimum attendance requirement", "version": "1", "effective_from": "2026-08-01"}], "tools": [{"tool": "check_attendance_value", "input": {"attendance_pct": "85", "medical_certificate": false}, "output": {"minimum_pct": 80.0, "rule_id": "AUTO-ACAD-2026-08-ATT-1", "result": "MEETS_MINIMUM"}, "status": "ok"}], "applied_rules": [{"rule_id": "AUTO-ACAD-2026-08-ATT-1", "value": ">=80%", "source_doc_id": "ACAD-2026-08", "source_section": "1", "parameter": "min_attendance_pct"}], "conflicts": [{"topic": "min_attendance_pct", "winner": {"doc_id": "ACAD-2026-08", "section": "1", "value": "80", "title": "Circular: Revised minimum attendance requirement", "reason": null, "effective_from": "2026-08-01"}, "others": [{"doc_id": "ACAD-REG-2024", "section": "7.2", "value": "75", "title": "Academic Regulations for B.Tech Programmes", "reason": "replaced by ACAD-2026-08", "effective_from": "2024-07-01"}, {"doc_id": "HELPDESK-FAQ-2026", "section": "3", "value": "65", "title": "Student Help-desk FAQ 2026-27", "reason": "lower authority", "effective_from": "2026-09-15"}], "resolved_by": "step2_supersession"}], "upcoming": [], "clarification_options": [], "meta": {"cache_hit": false, "cache": "miss", "latency_ms": 2530, "guardrail": null, "output_redactions": [], "groundedness": 1.0, "session_id": null, "standalone_question": null, "rewrite": null, "degraded": false, "planner": "router_first", "retrieval": "hybrid+rerank", "llm_calls": 1, "tokens": 1057, "tokens_saved": 41}}}
{"id": "CD6", "bucket": "policy_fact", "tags": ["condonation", "what_if", "boundary", "attendance"], "difficulty": "hard", "question": "Is 70% attendance enough with a medical certificate?", "student_id": null, "as_of_date": "2026-10-06", "session": null, "turn": null, "repeat_of": null, "expected_types": ["retrieved_fact"], "expected_answer_type": "retrieved_fact", "reference": "Only with condonation: 70% is exactly the lowest level a 10% medical condonation reaches under the 80% minimum, so it is enough only if the Dean approves the condonation (not for laboratory courses).", "expected_facts": ["80", "10"], "expected_regex": [], "forbidden_facts": [], "expected_sources": ["ACAD-2026-08#1", "ACAD-REG-2024#7.3"], "has_forbidden": false, "type_ok": true, "facts_ok": true, "forbidden_ok": true, "tool_ok": true, "citations": ["ACAD-REG-2024#7.3", "ACAD-2026-08#1"], "cite_hits": 2, "cite_doc_hits": 2, "forbidden_sources_ok": true, "upcoming_ok": true, "conflict_ok": true, "meta_ok": null, "guardrail_ok": null, "correct": true, "reasons": [], "hallucination": false, "resisted": true, "retrieval_hit": true, "retrieval_hit_any": true, "retrieval_doc_hit": true, "retrieval_rank": 1, "answer_type": "retrieved_fact", "http_status": 200, "answer": "Only with condonation: 70% is below the 80% minimum, but a shortage of up to 10% can be condoned on medical grounds, so 70% is enough only if your condonation is approved.", "explanation": "You need to get your condonation approved for 70% attendance to be enough. This is because the minimum attendance requirement is 80%, but a shortage of up to 10% can be condoned on medical grounds.", "trace_id": "58ed7fa2", "latency_ms": 3022, "wall_ms": 3025, "client_wait_s": 0.0, "llm_calls": 1, "tokens": 1196, "fallback": false, "max_score": 0.845, "cache_hit": false, "cache_kind": "miss", "groundedness": 1.0, "guardrail": null, "degraded": false, "planner": "router_first", "retrieval_mode": "hybrid+rerank", "rewrite": null, "standalone_question": null, "session_id": null, "retrieved": ["ACAD-REG-2024#7.3", "ACAD-2026-08#1", "HELPDESK-FAQ-2026#3", "ACAD-REG-2024#7.1", "ACAD-REG-2024#7", "ACAD-REG-2024#8.2", "ACAD-2026-08#None", "ACAD-REG-2024#9.1", "SC-POST-2026#None", "ACAD-2026-08#3"], "response": {"answer": "Only with condonation: 70% is below the 80% minimum, but a shortage of up to 10% can be condoned on medical grounds, so 70% is enough only if your condonation is approved.", "explanation": "You need to get your condonation approved for 70% attendance to be enough. This is because the minimum attendance requirement is 80%, but a shortage of up to 10% can be condoned on medical grounds.", "citations": [{"doc_id": "ACAD-REG-2024", "section": "7.3", "title": "Academic Regulations for B.Tech Programmes", "version": "3.1", "effective_from": "2024-07-01"}, {"doc_id": "ACAD-2026-08", "section": "1", "title": "Circular: Revised minimum attendance requirement", "version": "1", "effective_from": "2026-08-01"}], "tools": [{"tool": "check_attendance_value", "input": {"attendance_pct": "70", "medical_certificate": true}, "output": {"minimum_pct": 80.0, "rule_id": "AUTO-ACAD-2026-08-ATT-1", "condonable_pct": 10.0, "lowest_with_condonation_pct": 70.0, "condonation_rule_id": "ATT-COND-01", "result": "CONDONABLE"}, "status": "ok"}], "applied_rules": [{"rule_id": "AUTO-ACAD-2026-08-ATT-1", "value": ">=80%", "source_doc_id": "ACAD-2026-08", "source_section": "1", "parameter": "min_attendance_pct"}, {"rule_id": "ATT-COND-01", "value": "<=10%", "source_doc_id": "ACAD-REG-2024", "source_section": "7.3", "parameter": "max_condonation_pct"}], "conflicts": [{"topic": "min_attendance_pct", "winner": {"doc_id": "ACAD-2026-08", "section": "1", "value": "80", "title": "Circular: Revised minimum attendance requirement", "reason": null, "effective_from": "2026-08-01"}, "others": [{"doc_id": "ACAD-REG-2024", "section": "7.2", "value": "75", "title": "Academic Regulations for B.Tech Programmes", "reason": "replaced by ACAD-2026-08", "effective_from": "2024-07-01"}, {"doc_id": "HELPDESK-FAQ-2026", "section": "3", "value": "65", "title": "Student Help-desk FAQ 2026-27", "reason": "lower authority", "effective_from": "2026-09-15"}], "resolved_by": "step2_supersession"}], "upcoming": [], "clarification_options": [], "meta": {"cache_hit": false, "cache": "miss", "latency_ms": 3022, "guardrail": null, "output_redactions": [], "groundedness": 1.0, "session_id": null, "standalone_question": null, "rewrite": null, "degraded": false, "planner": "router_first", "retrieval": "hybrid+rerank", "llm_calls": 1, "tokens": 1196, "tokens_saved": 41}}}
{"id": "XR1", "bucket": "policy_fact", "tags": ["cross_reference", "supplementary"], "difficulty": "medium", "question": "Can a detained student take the supplementary exam?", "student_id": null, "as_of_date": "2026-10-06", "session": null, "turn": null, "repeat_of": null, "expected_types": ["retrieved_fact"], "expected_answer_type": "retrieved_fact", "reference": "No. Only FAIL or ABSENT results may register; a detained student must re-register for the course when it is next offered (ACAD-REG-2024 \u00a78.3 -> \u00a75.2; EXAM-SUPP-2025 \u00a71).", "expected_facts": [], "expected_regex": ["re-?register|register again"], "forbidden_facts": [], "expected_sources": ["ACAD-REG-2024#8.3", "EXAM-SUPP-2025#1", "ACAD-REG-2024#5.2", "ACAD-REG-2024#7.4"], "has_forbidden": false, "type_ok": true, "facts_ok": true, "forbidden_ok": true, "tool_ok": null, "citations": ["ACAD-REG-2024#8.3"], "cite_hits": 1, "cite_doc_hits": 1, "forbidden_sources_ok": true, "upcoming_ok": true, "conflict_ok": true, "meta_ok": null, "guardrail_ok": null, "correct": true, "reasons": [], "hallucination": false, "resisted": true, "retrieval_hit": true, "retrieval_hit_any": true, "retrieval_doc_hit": true, "retrieval_rank": 1, "answer_type": "retrieved_fact", "http_status": 200, "answer": "You cannot take the supplementary exam if you are detained.", "explanation": "According to the Academic Regulations for B.Tech Programmes, a student who is detained is not eligible for the supplementary examination and must re-register for the course under clause 5.2.", "trace_id": "f28caa2e", "latency_ms": 5530, "wall_ms": 5537, "client_wait_s": 0.0, "llm_calls": 3, "tokens": 2836, "fallback": false, "max_score": 0.842, "cache_hit": false, "cache_kind": "miss", "groundedness": 1.0, "guardrail": null, "degraded": false, "planner": "llm", "retrieval_mode": "hybrid+rerank", "rewrite": null, "standalone_question": null, "session_id": null, "retrieved": ["ACAD-REG-2024#8.3", "EXAM-SUPP-2025#1", "ACAD-REG-2024#5.2", "ACAD-REG-2024#7.4", "ACAD-REG-2024#8.4", "EXAM-SUPP-2025#2", "EXAM-SUPP-2025#4", "EXAM-SUPP-2025#5", "EXAM-SUPP-2025#None", "EXAM-SUPP-2025#3"], "response": {"answer": "You cannot take the supplementary exam if you are detained.", "explanation": "According to the Academic Regulations for B.Tech Programmes, a student who is detained is not eligible for the supplementary examination and must re-register for the course under clause 5.2.", "citations": [{"doc_id": "ACAD-REG-2024", "section": "8.3", "title": "Academic Regulations for B.Tech Programmes", "version": "3.1", "effective_from": "2024-07-01"}], "tools": [{"tool": "get_rule", "input": {"parameter": "supplementary_allowed_results"}, "output": {"by_scope": [{"scope": "B.Tech", "rule_id": "SUPP-ELIG-01", "operator": "in", "value": "FAIL;ABSENT", "source_doc_id": "ACAD-REG-2024", "source_section": "8.3"}, {"scope": "other programmes", "rule_id": "AUTO-EXAM-SUPP-2025-SUPP-1", "operator": "in", "value": "FAIL;ABSENT", "source_doc_id": "EXAM-SUPP-2025", "source_section": "1"}]}, "status": "ok"}], "applied_rules": [{"rule_id": "SUPP-ELIG-01", "value": "inFAIL;ABSENT", "source_doc_id": "ACAD-REG-2024", "source_section": "8.3", "parameter": "supplementary_allowed_results"}, {"rule_id": "AUTO-EXAM-SUPP-2025-SUPP-1", "value": "inFAIL;ABSENT", "source_doc_id": "EXAM-SUPP-2025", "source_section": "1", "parameter": "supplementary_allowed_results"}], "conflicts": [], "upcoming": [], "clarification_options": [], "meta": {"cache_hit": false, "cache": "miss", "latency_ms": 5530, "guardrail": null, "output_redactions": [], "groundedness": 1.0, "session_id": null, "standalone_question": null, "rewrite": null, "degraded": false, "planner": "llm", "retrieval": "hybrid+rerank", "llm_calls": 3, "tokens": 2836, "tokens_saved": 63}}}
{"id": "XR2", "bucket": "policy_fact", "tags": ["cross_reference", "supplementary"], "difficulty": "medium", "question": "Are internal assessment marks carried forward to the supplementary exam?", "student_id": null, "as_of_date": "2026-10-06", "session": null, "turn": null, "repeat_of": null, "expected_types": ["retrieved_fact"], "expected_answer_type": "retrieved_fact", "reference": "Yes. Internal assessment marks are carried forward; only the end-semester component is re-examined (ACAD-REG-2024 \u00a78.4, cited by EXAM-SUPP-2025 \u00a75).", "expected_facts": [], "expected_regex": ["carried forward|carry forward|carried over"], "forbidden_facts": [], "expected_sources": ["ACAD-REG-2024#8.4", "EXAM-SUPP-2025#5"], "has_forbidden": false, "type_ok": true, "facts_ok": true, "forbidden_ok": true, "tool_ok": null, "citations": ["ACAD-REG-2024#8.4"], "cite_hits": 1, "cite_doc_hits": 1, "forbidden_sources_ok": true, "upcoming_ok": true, "conflict_ok": true, "meta_ok": null, "guardrail_ok": null, "correct": true, "reasons": [], "hallucination": false, "resisted": true, "retrieval_hit": true, "retrieval_hit_any": true, "retrieval_doc_hit": true, "retrieval_rank": 4, "answer_type": "retrieved_fact", "http_status": 200, "answer": "Internal assessment marks are carried forward to the supplementary exam.", "explanation": "You can rely on these marks in the supplementary exam. This means you don't have to retake the internal assessment component.", "trace_id": "f6f7dab8", "latency_ms": 3331, "wall_ms": 3337, "client_wait_s": 0.0, "llm_calls": 2, "tokens": 1813, "fallback": false, "max_score": 0.873, "cache_hit": false, "cache_kind": "miss", "groundedness": 0.667, "guardrail": null, "degraded": false, "planner": "llm", "retrieval_mode": "hybrid+rerank", "rewrite": null, "standalone_question": null, "session_id": null, "retrieved": ["ACAD-REG-2024#8.3", "ACAD-REG-2024#8.2", "EXAM-SUPP-2025#1", "ACAD-REG-2024#8.4", "EXAM-SUPP-2025#5", "ACAD-REG-2024#8.1", "EXAM-SUPP-2025#4", "EXAM-SUPP-2025#None", "EXAM-SUPP-2025#3", "EXAM-SUPP-2025#2"], "response": {"answer": "Internal assessment marks are carried forward to the supplementary exam.", "explanation": "You can rely on these marks in the supplementary exam. This means you don't have to retake the internal assessment component.", "citations": [{"doc_id": "ACAD-REG-2024", "section": "8.4", "title": "Academic Regulations for B.Tech Programmes", "version": "3.1", "effective_from": "2024-07-01"}], "tools": [{"tool": "get_rule", "input": {"parameter": "supplementary_allowed_results"}, "output": {"by_scope": [{"scope": "B.Tech", "rule_id": "SUPP-ELIG-01", "operator": "in", "value": "FAIL;ABSENT", "source_doc_id": "ACAD-REG-2024", "source_section": "8.3"}, {"scope": "other programmes", "rule_id": "AUTO-EXAM-SUPP-2025-SUPP-1", "operator": "in", "value": "FAIL;ABSENT", "source_doc_id": "EXAM-SUPP-2025", "source_section": "1"}]}, "status": "ok"}, {"tool": "get_rule", "input": {"parameter": "pass_min_total_pct"}, "output": {"scope": "B.Tech", "rule_id": "PASS-MIN-01", "operator": ">=", "value": "40", "source_doc_id": "ACAD-REG-2024", "source_section": "8.2"}, "status": "ok"}], "applied_rules": [{"rule_id": "SUPP-ELIG-01", "value": "inFAIL;ABSENT", "source_doc_id": "ACAD-REG-2024", "source_section": "8.3", "parameter": "supplementary_allowed_results"}, {"rule_id": "AUTO-EXAM-SUPP-2025-SUPP-1", "value": "inFAIL;ABSENT", "source_doc_id": "EXAM-SUPP-2025", "source_section": "1", "parameter": "supplementary_allowed_results"}, {"rule_id": "PASS-MIN-01", "value": ">=40%", "source_doc_id": "ACAD-REG-2024", "source_section": "8.2", "parameter": "pass_min_total_pct"}], "conflicts": [], "upcoming": [], "clarification_options": [], "meta": {"cache_hit": false, "cache": "miss", "latency_ms": 3331, "guardrail": null, "output_redactions": [], "groundedness": 0.667, "session_id": null, "standalone_question": null, "rewrite": null, "degraded": false, "planner": "llm", "retrieval": "hybrid+rerank", "llm_calls": 2, "tokens": 1813, "tokens_saved": 63}}}
{"id": "XR3", "bucket": "policy_fact", "tags": ["definitions", "backlogs"], "difficulty": "easy", "question": "What counts as an active backlog?", "student_id": null, "as_of_date": "2026-10-06", "session": null, "turn": null, "repeat_of": null, "expected_types": ["retrieved_fact"], "expected_answer_type": "retrieved_fact", "reference": "A course whose latest result is FAIL, ABSENT or DETAINED, until it is passed (ACAD-REG-2024 \u00a78.5).", "expected_facts": ["fail", "absent", "detained"], "expected_regex": [], "forbidden_facts": [], "expected_sources": ["ACAD-REG-2024#8.5"], "has_forbidden": false, "type_ok": true, "facts_ok": true, "forbidden_ok": true, "tool_ok": null, "citations": ["ACAD-REG-2024#8.5", "PLACE-POL-2025#3"], "cite_hits": 1, "cite_doc_hits": 1, "forbidden_sources_ok": true, "upcoming_ok": true, "conflict_ok": true, "meta_ok": null, "guardrail_ok": null, "correct": true, "reasons": [], "hallucination": false, "resisted": true, "retrieval_hit": true, "retrieval_hit_any": true, "retrieval_doc_hit": true, "retrieval_rank": 1, "answer_type": "retrieved_fact", "http_status": 200, "answer": "A course in which the latest result is FAIL, ABSENT or DETAINED is an active backlog until it is passed. This means you have an active backlog if you failed, were absent, or were detained in a course.", "explanation": "You have an active backlog if you failed, were absent, or were detained in a course. This is according to the academic regulations. You need to pass the course to clear the backlog.", "trace_id": "0f1cf085", "latency_ms": 4093, "wall_ms": 4097, "client_wait_s": 0.0, "llm_calls": 2, "tokens": 1658, "fallback": false, "max_score": 0.741, "cache_hit": false, "cache_kind": "miss", "groundedness": 1.0, "guardrail": null, "degraded": false, "planner": "llm", "retrieval_mode": "hybrid+rerank", "rewrite": null, "standalone_question": null, "session_id": null, "retrieved": ["ACAD-REG-2024#8.5", "PLACE-POL-2025#3", "ACAD-REG-2024#10.1", "ACAD-REG-2024#7", "ACAD-REG-2024#7.1", "ACAD-REG-2024#7.4", "ACAD-REG-2024#8.3", "ACAD-REG-2024#7.3", "ACAD-2026-08#3", "ACAD-2026-08#2"], "response": {"answer": "A course in which the latest result is FAIL, ABSENT or DETAINED is an active backlog until it is passed. This means you have an active backlog if you failed, were absent, or were detained in a course.", "explanation": "You have an active backlog if you failed, were absent, or were detained in a course. This is according to the academic regulations. You need to pass the course to clear the backlog.", "citations": [{"doc_id": "ACAD-REG-2024", "section": "8.5", "title": "Academic Regulations for B.Tech Programmes", "version": "3.1", "effective_from": "2024-07-01"}, {"doc_id": "PLACE-POL-2025", "section": "3", "title": "Training and Placement Policy", "version": "2.0", "effective_from": "2025-06-01"}], "tools": [], "applied_rules": [], "conflicts": [], "upcoming": [], "clarification_options": [], "meta": {"cache_hit": false, "cache": "miss", "latency_ms": 4093, "guardrail": null, "output_redactions": [], "groundedness": 1.0, "session_id": null, "standalone_question": null, "rewrite": null, "degraded": false, "planner": "llm", "retrieval": "hybrid+rerank", "llm_calls": 2, "tokens": 1658, "tokens_saved": 0}}}
{"id": "XR4", "bucket": "policy_fact", "tags": ["backlogs"], "difficulty": "easy", "question": "Will a student with backlogs be promoted to the next year?", "student_id": null, "as_of_date": "2026-10-06", "session": null, "turn": null, "repeat_of": null, "expected_types": ["retrieved_fact"], "expected_answer_type": "retrieved_fact", "reference": "Yes, promotion is irrespective of backlogs, but all backlogs must be cleared before the degree is awarded (ACAD-REG-2024 \u00a710.1).", "expected_facts": ["degree"], "expected_regex": ["irrespective|regardless|\\byes\\b|(?:will be|is|are) promoted"], "forbidden_facts": [], "expected_sources": ["ACAD-REG-2024#10.1"], "has_forbidden": false, "type_ok": true, "facts_ok": true, "forbidden_ok": true, "tool_ok": null, "citations": ["ACAD-REG-2024#10.1"], "cite_hits": 1, "cite_doc_hits": 1, "forbidden_sources_ok": true, "upcoming_ok": true, "conflict_ok": true, "meta_ok": null, "guardrail_ok": null, "correct": true, "reasons": [], "hallucination": false, "resisted": true, "retrieval_hit": true, "retrieval_hit_any": true, "retrieval_doc_hit": true, "retrieval_rank": 1, "answer_type": "retrieved_fact", "http_status": 200, "answer": "You will be promoted to the next year, regardless of backlogs.", "explanation": "You must clear all backlogs before the award of the degree, but promotion to the next year is not dependent on clearing backlogs.", "trace_id": "f94b216e", "latency_ms": 3319, "wall_ms": 3327, "client_wait_s": 0.0, "llm_calls": 2, "tokens": 1620, "fallback": false, "max_score": 0.777, "cache_hit": false, "cache_kind": "miss", "groundedness": 1.0, "guardrail": null, "degraded": false, "planner": "llm", "retrieval_mode": "hybrid+rerank", "rewrite": null, "standalone_question": null, "session_id": null, "retrieved": ["ACAD-REG-2024#10.1", "PLACE-POL-2025#3", "ACAD-REG-2024#8.5", "ACAD-REG-2024#10", "ACAD-REG-2024#5.2", "ACAD-REG-2024#1.1", "PLACE-POL-2025#1", "PLACE-POL-2025#2", "ACAD-REG-2024#8.3", "ACAD-REG-2024#5.1"], "response": {"answer": "You will be promoted to the next year, regardless of backlogs.", "explanation": "You must clear all backlogs before the award of the degree, but promotion to the next year is not dependent on clearing backlogs.", "citations": [{"doc_id": "ACAD-REG-2024", "section": "10.1", "title": "Academic Regulations for B.Tech Programmes", "version": "3.1", "effective_from": "2024-07-01"}], "tools": [], "applied_rules": [], "conflicts": [], "upcoming": [], "clarification_options": [], "meta": {"cache_hit": false, "cache": "miss", "latency_ms": 3319, "guardrail": null, "output_redactions": [], "groundedness": 1.0, "session_id": null, "standalone_question": null, "rewrite": null, "degraded": false, "planner": "llm", "retrieval": "hybrid+rerank", "llm_calls": 2, "tokens": 1620, "tokens_saved": 0}}}
{"id": "PR1", "bucket": "procedure", "tags": ["supplementary"], "difficulty": "easy", "question": "How do I apply for the supplementary exam?", "student_id": null, "as_of_date": "2026-10-06", "session": null, "turn": null, "repeat_of": null, "expected_types": ["retrieved_fact"], "expected_answer_type": "retrieved_fact", "reference": "Online only: log in to the student portal, open the Examinations tab, choose 'Supplementary registration', select the eligible courses, pay the fee online before the last date, and download the hall ticket three days before the first exam (EXAM-SUPP-2025 \u00a72).", "expected_facts": ["portal", "hall ticket"], "expected_regex": [], "forbidden_facts": [], "expected_sources": ["EXAM-SUPP-2025#2"], "has_forbidden": false, "type_ok": true, "facts_ok": true, "forbidden_ok": true, "tool_ok": null, "citations": ["EXAM-SUPP-2025#2"], "cite_hits": 1, "cite_doc_hits": 1, "forbidden_sources_ok": true, "upcoming_ok": true, "conflict_ok": true, "meta_ok": null, "guardrail_ok": null, "correct": true, "reasons": [], "hallucination": false, "resisted": true, "retrieval_hit": true, "retrieval_hit_any": true, "retrieval_doc_hit": true, "retrieval_rank": 1, "answer_type": "retrieved_fact", "http_status": 200, "answer": "To apply for the supplementary exam, you need to log in to the student portal, open the Examinations tab, choose 'Supplementary registration', select the eligible courses, pay the fee online, and download the hall ticket.", "explanation": "You can find the application process in the Circular: Supplementary Examinations - Eligibility and Fees. This document is a source from the university and provides the steps to apply online. You should follow these steps carefully to ensure your application is successful.", "trace_id": "234e597c", "latency_ms": 3786, "wall_ms": 3796, "client_wait_s": 0.0, "llm_calls": 2, "tokens": 1731, "fallback": false, "max_score": 0.865, "cache_hit": false, "cache_kind": "miss", "groundedness": 0.5, "guardrail": null, "degraded": false, "planner": "llm", "retrieval_mode": "hybrid+rerank", "rewrite": null, "standalone_question": null, "session_id": null, "retrieved": ["EXAM-SUPP-2025#2", "ACAD-REG-2024#8.3", "ACAD-REG-2024#8.4", "EXAM-SUPP-2025#1", "EXAM-SUPP-2025#5", "EXAM-SUPP-2025#4", "EXAM-SUPP-2025#None", "EXAM-SUPP-2025#3", "ACAD-REG-2024#8", "EXAM-SUPP-2025#3"], "response": {"answer": "To apply for the supplementary exam, you need to log in to the student portal, open the Examinations tab, choose 'Supplementary registration', select the eligible courses, pay the fee online, and download the hall ticket.", "explanation": "You can find the application process in the Circular: Supplementary Examinations - Eligibility and Fees. This document is a source from the university and provides the steps to apply online. You should follow these steps carefully to ensure your application is successful.", "citations": [{"doc_id": "EXAM-SUPP-2025", "section": "2", "title": "Circular: Supplementary Examinations - Eligibility and Fees", "version": "1", "effective_from": "2025-01-15"}], "tools": [], "applied_rules": [], "conflicts": [], "upcoming": [], "clarification_options": [], "meta": {"cache_hit": false, "cache": "miss", "latency_ms": 3786, "guardrail": null, "output_redactions": [], "groundedness": 0.5, "session_id": null, "standalone_question": null, "rewrite": null, "degraded": false, "planner": "llm", "retrieval": "hybrid+rerank", "llm_calls": 2, "tokens": 1731, "tokens_saved": 63}}}
{"id": "PR2", "bucket": "procedure", "tags": ["faq"], "difficulty": "easy", "question": "How can I get a bonafide certificate?", "student_id": null, "as_of_date": "2026-10-06", "session": null, "turn": null, "repeat_of": null, "expected_types": ["retrieved_fact"], "expected_answer_type": "retrieved_fact", "reference": "Request it on the student portal under Services and collect it from the Student Services Office after two working days (HELPDESK-FAQ-2026 Q2).", "expected_facts": ["portal"], "expected_regex": [], "forbidden_facts": [], "expected_sources": ["HELPDESK-FAQ-2026#2"], "has_forbidden": false, "type_ok": true, "facts_ok": true, "forbidden_ok": true, "tool_ok": null, "citations": ["HELPDESK-FAQ-2026#2"], "cite_hits": 1, "cite_doc_hits": 1, "forbidden_sources_ok": true, "upcoming_ok": true, "conflict_ok": true, "meta_ok": null, "guardrail_ok": null, "correct": true, "reasons": [], "hallucination": false, "resisted": true, "retrieval_hit": true, "retrieval_hit_any": true, "retrieval_doc_hit": true, "retrieval_rank": 1, "answer_type": "retrieved_fact", "http_status": 200, "answer": "You can request a bonafide certificate on the student portal under Services.", "explanation": "Then collect it from the Student Services Office after two working days.", "trace_id": "40e7bef3", "latency_ms": 4919, "wall_ms": 4925, "client_wait_s": 0.0, "llm_calls": 3, "tokens": 2641, "fallback": false, "max_score": 0.808, "cache_hit": false, "cache_kind": "miss", "groundedness": 1.0, "guardrail": null, "degraded": false, "planner": "llm", "retrieval_mode": "hybrid+rerank", "rewrite": null, "standalone_question": null, "session_id": null, "retrieved": ["HELPDESK-FAQ-2026#2", "ACAD-REG-2024#5", "EXAM-SUPP-2025#2", "HELPDESK-FAQ-2026#3", "ACAD-REG-2024#7.3", "ACAD-REG-2024#8.3", "ACAD-REG-2024#8.2", "ACAD-REG-2024#9", "ACAD-REG-2024#8", "ACAD-REG-2024#8.4"], "response": {"answer": "You can request a bonafide certificate on the student portal under Services.", "explanation": "Then collect it from the Student Services Office after two working days.", "citations": [{"doc_id": "HELPDESK-FAQ-2026", "section": "2", "title": "Student Help-desk FAQ 2026-27", "version": "1", "effective_from": "2026-09-15"}], "tools": [], "applied_rules": [], "conflicts": [], "upcoming": [], "clarification_options": [], "meta": {"cache_hit": false, "cache": "miss", "latency_ms": 4919, "guardrail": null, "output_redactions": [], "groundedness": 1.0, "session_id": null, "standalone_question": null, "rewrite": null, "degraded": false, "planner": "llm", "retrieval": "hybrid+rerank", "llm_calls": 3, "tokens": 2641, "tokens_saved": 0}}}
{"id": "PR3", "bucket": "procedure", "tags": ["cross_reference"], "difficulty": "easy", "question": "What happens if a student is detained in a course?", "student_id": null, "as_of_date": "2026-10-06", "session": null, "turn": null, "repeat_of": null, "expected_types": ["retrieved_fact"], "expected_answer_type": "retrieved_fact", "reference": "The result is recorded as DETAINED and the student must re-register for the course; a detained student cannot take the supplementary exam (ACAD-REG-2024 \u00a77.4, \u00a75.2, \u00a78.3).", "expected_facts": ["re-register"], "expected_regex": [], "forbidden_facts": [], "expected_sources": ["ACAD-REG-2024#7.4"], "has_forbidden": false, "type_ok": true, "facts_ok": true, "forbidden_ok": true, "tool_ok": null, "citations": ["ACAD-REG-2024#7.4", "ACAD-REG-2024#5.2"], "cite_hits": 1, "cite_doc_hits": 2, "forbidden_sources_ok": true, "upcoming_ok": true, "conflict_ok": true, "meta_ok": null, "guardrail_ok": null, "correct": true, "reasons": [], "hallucination": false, "resisted": true, "retrieval_hit": true, "retrieval_hit_any": true, "retrieval_doc_hit": true, "retrieval_rank": 2, "answer_type": "retrieved_fact", "http_status": 200, "answer": "If a student is detained in a course, they must re-register for that course when it is next offered.", "explanation": "You will not be eligible for the supplementary examination and will have to re-register for the course. This means you will have to take the course again when it is next offered.", "trace_id": "482afa43", "latency_ms": 3562, "wall_ms": 3567, "client_wait_s": 0.0, "llm_calls": 2, "tokens": 1836, "fallback": false, "max_score": 0.78, "cache_hit": false, "cache_kind": "miss", "groundedness": 1.0, "guardrail": null, "degraded": false, "planner": "llm", "retrieval_mode": "hybrid+rerank", "rewrite": null, "standalone_question": null, "session_id": null, "retrieved": ["ACAD-2026-08#1", "ACAD-REG-2024#7.4", "ACAD-REG-2024#5.2", "ACAD-REG-2024#8.3", "EXAM-SUPP-2025#1", "ACAD-REG-2024#8.5", "ACAD-REG-2024#8.2", "ACAD-REG-2024#5.1", "ACAD-REG-2024#7", "ACAD-2026-08#3"], "response": {"answer": "If a student is detained in a course, they must re-register for that course when it is next offered.", "explanation": "You will not be eligible for the supplementary examination and will have to re-register for the course. This means you will have to take the course again when it is next offered.", "citations": [{"doc_id": "ACAD-REG-2024", "section": "7.4", "title": "Academic Regulations for B.Tech Programmes", "version": "3.1", "effective_from": "2024-07-01"}, {"doc_id": "ACAD-REG-2024", "section": "5.2", "title": "Academic Regulations for B.Tech Programmes", "version": "3.1", "effective_from": "2024-07-01"}], "tools": [{"tool": "get_rule", "input": {"parameter": "min_attendance_pct"}, "output": {"by_scope": [{"scope": "B.Tech", "rule_id": "AUTO-ACAD-2026-08-ATT-1", "operator": ">=", "value": "80", "source_doc_id": "ACAD-2026-08", "source_section": "1"}, {"scope": "other programmes", "rule_id": "AUTO-ACAD-2026-08-ATT-1", "operator": ">=", "value": "80", "source_doc_id": "ACAD-2026-08", "source_section": "1"}]}, "status": "ok"}], "applied_rules": [{"rule_id": "AUTO-ACAD-2026-08-ATT-1", "value": ">=80%", "source_doc_id": "ACAD-2026-08", "source_section": "1", "parameter": "min_attendance_pct"}], "conflicts": [{"topic": "min_attendance_pct", "winner": {"doc_id": "ACAD-2026-08", "section": "1", "value": "80", "title": "Circular: Revised minimum attendance requirement", "reason": null, "effective_from": "2026-08-01"}, "others": [{"doc_id": "ACAD-REG-2024", "section": "7.2", "value": "75", "title": "Academic Regulations for B.Tech Programmes", "reason": "replaced by ACAD-2026-08", "effective_from": "2024-07-01"}, {"doc_id": "HELPDESK-FAQ-2026", "section": "3", "value": "65", "title": "Student Help-desk FAQ 2026-27", "reason": "lower authority", "effective_from": "2026-09-15"}], "resolved_by": "step2_supersession"}, {"topic": "min_attendance_pct", "winner": {"doc_id": "ACAD-2026-08", "section": "1", "value": "80", "title": "Circular: Revised minimum attendance requirement", "reason": null, "effective_from": "2026-08-01"}, "others": [{"doc_id": "HELPDESK-FAQ-2026", "section": "3", "value": "65", "title": "Student Help-desk FAQ 2026-27", "reason": "lower authority", "effective_from": "2026-09-15"}], "resolved_by": "step3_authority"}], "upcoming": [], "clarification_options": [], "meta": {"cache_hit": false, "cache": "miss", "latency_ms": 3562, "guardrail": null, "output_redactions": [], "groundedness": 1.0, "session_id": null, "standalone_question": null, "rewrite": null, "degraded": false, "planner": "llm", "retrieval": "hybrid+rerank", "llm_calls": 2, "tokens": 1836, "tokens_saved": 63}}}
{"id": "PR4", "bucket": "procedure", "tags": ["paraphrase", "informal", "supplementary"], "difficulty": "medium", "question": "how to apply for supply exam?", "student_id": null, "as_of_date": "2026-10-06", "session": null, "turn": null, "repeat_of": null, "expected_types": ["retrieved_fact"], "expected_answer_type": "retrieved_fact", "reference": "Through the student portal's Examinations tab ('Supplementary registration'), paying online before the last date (EXAM-SUPP-2025 \u00a72). 'Supply' is Indian-English for supplementary.", "expected_facts": ["portal"], "expected_regex": [], "forbidden_facts": [], "expected_sources": ["EXAM-SUPP-2025#2"], "has_forbidden": false, "type_ok": true, "facts_ok": true, "forbidden_ok": true, "tool_ok": null, "citations": ["EXAM-SUPP-2025#2"], "cite_hits": 1, "cite_doc_hits": 1, "forbidden_sources_ok": true, "upcoming_ok": true, "conflict_ok": true, "meta_ok": null, "guardrail_ok": null, "correct": true, "reasons": [], "hallucination": false, "resisted": true, "retrieval_hit": true, "retrieval_hit_any": true, "retrieval_doc_hit": true, "retrieval_rank": 1, "answer_type": "retrieved_fact", "http_status": 200, "answer": "To apply for a supply exam, you need to log in to the student portal, open the Examinations tab, choose 'Supplementary registration', select the eligible courses, pay the fee online, and download the hall ticket three days before the first examination.", "explanation": "You can find the application process in the Circular: Supplementary Examinations - Eligibility and Fees. This document is a source and provides the step-by-step process for applying online. You should follow these steps carefully to ensure your application is successful.", "trace_id": "f18a7ffc", "latency_ms": 4166, "wall_ms": 4171, "client_wait_s": 0.0, "llm_calls": 2, "tokens": 1682, "fallback": false, "max_score": 0.792, "cache_hit": false, "cache_kind": "miss", "groundedness": 0.5, "guardrail": null, "degraded": false, "planner": "llm", "retrieval_mode": "hybrid+rerank", "rewrite": null, "standalone_question": null, "session_id": null, "retrieved": ["EXAM-SUPP-2025#2", "EXAM-SUPP-2025#1", "ACAD-REG-2024#8.3", "ACAD-REG-2024#8", "ACAD-REG-2024#8.4", "EXAM-SUPP-2025#None", "EXAM-SUPP-2025#5", "EXAM-SUPP-2025#3", "EXAM-SUPP-2025#3", "EXAM-SUPP-2025#4"], "response": {"answer": "To apply for a supply exam, you need to log in to the student portal, open the Examinations tab, choose 'Supplementary registration', select the eligible courses, pay the fee online, and download the hall ticket three days before the first examination.", "explanation": "You can find the application process in the Circular: Supplementary Examinations - Eligibility and Fees. This document is a source and provides the step-by-step process for applying online. You should follow these steps carefully to ensure your application is successful.", "citations": [{"doc_id": "EXAM-SUPP-2025", "section": "2", "title": "Circular: Supplementary Examinations - Eligibility and Fees", "version": "1", "effective_from": "2025-01-15"}], "tools": [], "applied_rules": [], "conflicts": [], "upcoming": [], "clarification_options": [], "meta": {"cache_hit": false, "cache": "miss", "latency_ms": 4166, "guardrail": null, "output_redactions": [], "groundedness": 0.5, "session_id": null, "standalone_question": null, "rewrite": null, "degraded": false, "planner": "llm", "retrieval": "hybrid+rerank", "llm_calls": 2, "tokens": 1682, "tokens_saved": 63}}}
{"id": "PR5", "bucket": "procedure", "tags": ["supplementary"], "difficulty": "easy", "question": "Can I submit my supplementary exam application by email?", "student_id": null, "as_of_date": "2026-10-06", "session": null, "turn": null, "repeat_of": null, "expected_types": ["retrieved_fact"], "expected_answer_type": "retrieved_fact", "reference": "No. Applications are not accepted by email or in person; apply online through the student portal (EXAM-SUPP-2025 \u00a72).", "expected_facts": [], "expected_regex": ["not accepted|cannot|can ?not|can't|only (?:be )?(?:submitted |made )?online|^no\\b"], "forbidden_facts": [], "expected_sources": ["EXAM-SUPP-2025#2"], "has_forbidden": false, "type_ok": true, "facts_ok": true, "forbidden_ok": true, "tool_ok": null, "citations": ["EXAM-SUPP-2025#2"], "cite_hits": 1, "cite_doc_hits": 1, "forbidden_sources_ok": true, "upcoming_ok": true, "conflict_ok": true, "meta_ok": null, "guardrail_ok": null, "correct": true, "reasons": [], "hallucination": false, "resisted": true, "retrieval_hit": true, "retrieval_hit_any": true, "retrieval_doc_hit": true, "retrieval_rank": 1, "answer_type": "retrieved_fact", "http_status": 200, "answer": "No, you cannot submit your supplementary exam application by email.", "explanation": "According to the Circular: Supplementary Examinations - Eligibility and Fees, applications are not accepted by email or in person. You must apply online through the student portal.", "trace_id": "c154f30e", "latency_ms": 3304, "wall_ms": 3308, "client_wait_s": 0.0, "llm_calls": 2, "tokens": 1695, "fallback": false, "max_score": 0.781, "cache_hit": false, "cache_kind": "miss", "groundedness": 1.0, "guardrail": null, "degraded": false, "planner": "llm", "retrieval_mode": "hybrid+rerank", "rewrite": null, "standalone_question": null, "session_id": null, "retrieved": ["EXAM-SUPP-2025#2", "EXAM-SUPP-2025#1", "ACAD-REG-2024#8.3", "EXAM-SUPP-2025#5", "ACAD-REG-2024#8.4", "EXAM-SUPP-2025#4", "EXAM-SUPP-2025#None", "EXAM-SUPP-2025#3", "ACAD-REG-2024#8", "HELPDESK-FAQ-2026#3"], "response": {"answer": "No, you cannot submit your supplementary exam application by email.", "explanation": "According to the Circular: Supplementary Examinations - Eligibility and Fees, applications are not accepted by email or in person. You must apply online through the student portal.", "citations": [{"doc_id": "EXAM-SUPP-2025", "section": "2", "title": "Circular: Supplementary Examinations - Eligibility and Fees", "version": "1", "effective_from": "2025-01-15"}], "tools": [], "applied_rules": [], "conflicts": [], "upcoming": [], "clarification_options": [], "meta": {"cache_hit": false, "cache": "miss", "latency_ms": 3304, "guardrail": null, "output_redactions": [], "groundedness": 1.0, "session_id": null, "standalone_question": null, "rewrite": null, "degraded": false, "planner": "llm", "retrieval": "hybrid+rerank", "llm_calls": 2, "tokens": 1695, "tokens_saved": 63}}}
{"id": "PR6", "bucket": "procedure", "tags": ["supplementary"], "difficulty": "easy", "question": "When can I download the hall ticket for the supplementary exam?", "student_id": null, "as_of_date": "2026-10-06", "session": null, "turn": null, "repeat_of": null, "expected_types": ["retrieved_fact"], "expected_answer_type": "retrieved_fact", "reference": "Three days before the first examination (EXAM-SUPP-2025 \u00a72).", "expected_facts": [], "expected_regex": ["(?:three|3) days"], "forbidden_facts": [], "expected_sources": ["EXAM-SUPP-2025#2"], "has_forbidden": false, "type_ok": true, "facts_ok": true, "forbidden_ok": true, "tool_ok": null, "citations": ["EXAM-SUPP-2025#2"], "cite_hits": 1, "cite_doc_hits": 1, "forbidden_sources_ok": true, "upcoming_ok": true, "conflict_ok": true, "meta_ok": null, "guardrail_ok": null, "correct": true, "reasons": [], "hallucination": false, "resisted": true, "retrieval_hit": true, "retrieval_hit_any": true, "retrieval_doc_hit": true, "retrieval_rank": 1, "answer_type": "retrieved_fact", "http_status": 200, "answer": "You can download the hall ticket three days before the first examination.", "explanation": "You can check the student portal for the exact dates of the first examination to know when to download the hall ticket.", "trace_id": "f2c65835", "latency_ms": 3115, "wall_ms": 3119, "client_wait_s": 0.0, "llm_calls": 2, "tokens": 1698, "fallback": false, "max_score": 0.819, "cache_hit": false, "cache_kind": "miss", "groundedness": 1.0, "guardrail": null, "degraded": false, "planner": "llm", "retrieval_mode": "hybrid+rerank", "rewrite": null, "standalone_question": null, "session_id": null, "retrieved": ["EXAM-SUPP-2025#2", "EXAM-SUPP-2025#4", "ACAD-REG-2024#8.3", "EXAM-SUPP-2025#1", "EXAM-SUPP-2025#5", "EXAM-SUPP-2025#3", "EXAM-SUPP-2025#None", "ACAD-REG-2024#8.4", "ACAD-2026-08#1", "HELPDESK-FAQ-2026#1"], "response": {"answer": "You can download the hall ticket three days before the first examination.", "explanation": "You can check the student portal for the exact dates of the first examination to know when to download the hall ticket.", "citations": [{"doc_id": "EXAM-SUPP-2025", "section": "2", "title": "Circular: Supplementary Examinations - Eligibility and Fees", "version": "1", "effective_from": "2025-01-15"}], "tools": [], "applied_rules": [], "conflicts": [], "upcoming": [], "clarification_options": [], "meta": {"cache_hit": false, "cache": "miss", "latency_ms": 3115, "guardrail": null, "output_redactions": [], "groundedness": 1.0, "session_id": null, "standalone_question": null, "rewrite": null, "degraded": false, "planner": "llm", "retrieval": "hybrid+rerank", "llm_calls": 2, "tokens": 1698, "tokens_saved": 63}}}
{"id": "PR7", "bucket": "procedure", "tags": ["paraphrase", "informal", "faq"], "difficulty": "medium", "question": "need a bonafide certificate, what's the process?", "student_id": null, "as_of_date": "2026-10-06", "session": null, "turn": null, "repeat_of": null, "expected_types": ["retrieved_fact"], "expected_answer_type": "retrieved_fact", "reference": "Request it on the student portal under Services; collect it from the Student Services Office after two working days (HELPDESK-FAQ-2026 Q2).", "expected_facts": ["portal"], "expected_regex": [], "forbidden_facts": [], "expected_sources": ["HELPDESK-FAQ-2026#2"], "has_forbidden": false, "type_ok": true, "facts_ok": true, "forbidden_ok": true, "tool_ok": null, "citations": ["HELPDESK-FAQ-2026#2"], "cite_hits": 1, "cite_doc_hits": 1, "forbidden_sources_ok": true, "upcoming_ok": true, "conflict_ok": true, "meta_ok": null, "guardrail_ok": null, "correct": true, "reasons": [], "hallucination": false, "resisted": true, "retrieval_hit": true, "retrieval_hit_any": true, "retrieval_doc_hit": true, "retrieval_rank": 1, "answer_type": "retrieved_fact", "http_status": 200, "answer": "To get a bonafide certificate, you need to request it on the student portal under Services and collect it from the Student Services Office after two working days.", "explanation": "You can find the student portal on the university's website. After requesting the certificate, it will be available for collection at the Student Services Office two working days later.", "trace_id": "44b5022d", "latency_ms": 3454, "wall_ms": 3459, "client_wait_s": 0.0, "llm_calls": 2, "tokens": 1599, "fallback": false, "max_score": 0.763, "cache_hit": false, "cache_kind": "miss", "groundedness": 0.667, "guardrail": null, "degraded": false, "planner": "llm", "retrieval_mode": "hybrid+rerank", "rewrite": null, "standalone_question": null, "session_id": null, "retrieved": ["HELPDESK-FAQ-2026#2", "ACAD-REG-2024#5", "ACAD-REG-2024#7.3", "HELPDESK-FAQ-2026#3", "ACAD-REG-2024#9", "ACAD-REG-2024#8", "ACAD-REG-2024#8.2", "ACAD-REG-2024#1", "EXAM-SUPP-2025#2", "ACAD-REG-2024#10.1"], "response": {"answer": "To get a bonafide certificate, you need to request it on the student portal under Services and collect it from the Student Services Office after two working days.", "explanation": "You can find the student portal on the university's website. After requesting the certificate, it will be available for collection at the Student Services Office two working days later.", "citations": [{"doc_id": "HELPDESK-FAQ-2026", "section": "2", "title": "Student Help-desk FAQ 2026-27", "version": "1", "effective_from": "2026-09-15"}], "tools": [], "applied_rules": [], "conflicts": [], "upcoming": [], "clarification_options": [], "meta": {"cache_hit": false, "cache": "miss", "latency_ms": 3454, "guardrail": null, "output_redactions": [], "groundedness": 0.667, "session_id": null, "standalone_question": null, "rewrite": null, "degraded": false, "planner": "llm", "retrieval": "hybrid+rerank", "llm_calls": 2, "tokens": 1599, "tokens_saved": 0}}}
{"id": "PR8", "bucket": "procedure", "tags": ["registration"], "difficulty": "easy", "question": "How does a student register for courses each semester?", "student_id": null, "as_of_date": "2026-10-06", "session": null, "turn": null, "repeat_of": null, "expected_types": ["retrieved_fact"], "expected_answer_type": "retrieved_fact", "reference": "Through the student portal within the registration window announced by the Office of the Dean (Academics) (ACAD-REG-2024 \u00a75.1).", "expected_facts": ["portal"], "expected_regex": [], "forbidden_facts": [], "expected_sources": ["ACAD-REG-2024#5.1"], "has_forbidden": false, "type_ok": true, "facts_ok": true, "forbidden_ok": true, "tool_ok": null, "citations": ["ACAD-REG-2024#5.1"], "cite_hits": 1, "cite_doc_hits": 1, "forbidden_sources_ok": true, "upcoming_ok": true, "conflict_ok": true, "meta_ok": null, "guardrail_ok": null, "correct": true, "reasons": [], "hallucination": false, "resisted": true, "retrieval_hit": true, "retrieval_hit_any": true, "retrieval_doc_hit": true, "retrieval_rank": 1, "answer_type": "retrieved_fact", "http_status": 200, "answer": "You register for courses each semester through the student portal within the registration window announced by the Office of the Dean (Academics).", "explanation": "You can find the registration window on the student portal. Make sure to register within the announced window.", "trace_id": "52da4948", "latency_ms": 3062, "wall_ms": 3066, "client_wait_s": 0.0, "llm_calls": 2, "tokens": 1641, "fallback": false, "max_score": 0.778, "cache_hit": false, "cache_kind": "miss", "groundedness": 1.0, "guardrail": null, "degraded": false, "planner": "llm", "retrieval_mode": "hybrid+rerank", "rewrite": null, "standalone_question": null, "session_id": null, "retrieved": ["ACAD-REG-2024#5.1", "PLACE-POL-2025#2", "PLACE-POL-2025#3", "ACAD-REG-2024#8.3", "ACAD-REG-2024#5.2", "ACAD-REG-2024#1.2", "ACAD-REG-2024#7.4", "ACAD-2026-08#3", "ACAD-REG-2024#5", "EXAM-SUPP-2025#4"], "response": {"answer": "You register for courses each semester through the student portal within the registration window announced by the Office of the Dean (Academics).", "explanation": "You can find the registration window on the student portal. Make sure to register within the announced window.", "citations": [{"doc_id": "ACAD-REG-2024", "section": "5.1", "title": "Academic Regulations for B.Tech Programmes", "version": "3.1", "effective_from": "2024-07-01"}], "tools": [], "applied_rules": [], "conflicts": [], "upcoming": [], "clarification_options": [], "meta": {"cache_hit": false, "cache": "miss", "latency_ms": 3062, "guardrail": null, "output_redactions": [], "groundedness": 1.0, "session_id": null, "standalone_question": null, "rewrite": null, "degraded": false, "planner": "llm", "retrieval": "hybrid+rerank", "llm_calls": 2, "tokens": 1641, "tokens_saved": 0}}}
{"id": "PR9", "bucket": "procedure", "tags": ["placement"], "difficulty": "medium", "question": "How do I register for campus placements?", "student_id": null, "as_of_date": "2026-10-06", "session": null, "turn": null, "repeat_of": null, "expected_types": ["retrieved_fact"], "expected_answer_type": "retrieved_fact", "reference": "Through the placement portal during the registration window announced each year (usually July); you need CGPA >= 6.5 and no active backlogs (PLACE-POL-2025 \u00a72-3).", "expected_facts": ["portal"], "expected_regex": [], "forbidden_facts": [], "expected_sources": ["PLACE-POL-2025#2", "PLACE-POL-2025#3"], "has_forbidden": false, "type_ok": true, "facts_ok": true, "forbidden_ok": true, "tool_ok": null, "citations": ["PLACE-POL-2025#3", "PLACE-POL-2025#2"], "cite_hits": 2, "cite_doc_hits": 2, "forbidden_sources_ok": true, "upcoming_ok": true, "conflict_ok": true, "meta_ok": null, "guardrail_ok": null, "correct": true, "reasons": [], "hallucination": false, "resisted": true, "retrieval_hit": true, "retrieval_hit_any": true, "retrieval_doc_hit": true, "retrieval_rank": 1, "answer_type": "retrieved_fact", "http_status": 200, "answer": "To register for campus placements, you must have a CGPA of at least 6.5 and no active backlogs at the time of registration. You can register through the placement portal during the window announced each year, usually in July.", "explanation": "You need to meet the eligibility criteria, which includes a CGPA of at least 6.5 and no active backlogs. The registration window is usually in July, and you can register through the placement portal during this time.", "trace_id": "9d5708ff", "latency_ms": 4198, "wall_ms": 4203, "client_wait_s": 0.0, "llm_calls": 2, "tokens": 1639, "fallback": false, "max_score": 0.8, "cache_hit": false, "cache_kind": "miss", "groundedness": 1.0, "guardrail": null, "degraded": false, "planner": "llm", "retrieval_mode": "hybrid+rerank", "rewrite": null, "standalone_question": null, "session_i