{"id": "PF16", "bucket": "policy_fact", "tags": ["supplementary"], "difficulty": "easy", "question": "When are supplementary exams held for odd-semester courses?", "student_id": null, "as_of_date": "2026-10-06", "session": null, "turn": null, "repeat_of": null, "expected_types": ["retrieved_fact"], "expected_answer_type": "retrieved_fact", "reference": "In January (even-semester courses in July); exact dates are on the examinations notice board (EXAM-SUPP-2025 \u00a74).", "expected_facts": ["january"], "expected_regex": [], "forbidden_facts": [], "expected_sources": ["EXAM-SUPP-2025#4"], "has_forbidden": false, "type_ok": true, "facts_ok": true, "forbidden_ok": true, "tool_ok": null, "citations": ["EXAM-SUPP-2025#4"], "cite_hits": 1, "cite_doc_hits": 1, "forbidden_sources_ok": true, "upcoming_ok": true, "conflict_ok": true, "meta_ok": null, "guardrail_ok": null, "correct": true, "reasons": [], "hallucination": false, "resisted": true, "retrieval_hit": true, "retrieval_hit_any": true, "retrieval_doc_hit": true, "retrieval_rank": 3, "answer_type": "retrieved_fact", "http_status": 200, "answer": "Supplementary exams for odd-semester courses are held in January.", "explanation": "You can check the exact dates on the examinations notice board.", "trace_id": "3b5681a2", "latency_ms": 2771, "wall_ms": 2776, "client_wait_s": 0.0, "llm_calls": 2, "tokens": 1755, "fallback": false, "max_score": 0.886, "cache_hit": false, "cache_kind": "miss", "groundedness": 1.0, "guardrail": null, "degraded": false, "planner": "llm", "retrieval_mode": "hybrid+rerank", "rewrite": null, "standalone_question": null, "session_id": null, "retrieved": ["ACAD-REG-2024#8.3", "EXAM-SUPP-2025#1", "EXAM-SUPP-2025#4", "ACAD-REG-2024#8.4", "EXAM-SUPP-2025#None", "ACAD-2026-08#1", "EXAM-SUPP-2025#5", "EXAM-SUPP-2025#3", "EXAM-SUPP-2025#2", "HELPDESK-FAQ-2026#1"], "response": {"answer": "Supplementary exams for odd-semester courses are held in January.", "explanation": "You can check the exact dates on the