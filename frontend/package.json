{
  "name": "uniassist-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "UniAssist web UI: ask about university rules and your record, and see how every answer was decided.",
  "scripts": {
    "dev": "vite",
    "dev:mock": "VITE_MOCK=1 vite",
    "build": "tsc --noEmit && vite build",
