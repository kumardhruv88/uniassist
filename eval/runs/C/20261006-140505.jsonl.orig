{"id": "VC7", "bucket": "versions_conflicts", "tags": ["as_of", "boundary", "version", "attendance"], "difficulty": "hard", "question": "What is the minimum attendance required to sit end-semester exams?", "student_id": null, "as_of_date": "2026-08-01", "session": null, "turn": null, "repeat_of": null, "expected_types": ["retrieved_fact"], "expected_answer_type": "retrieved_fact", "reference": "80%: ACAD-2026-08 takes effect on 1 August 2026, so it already applies on that day (effective dates are inclusive).", "expected_facts": ["80"], "expected_regex": [], "forbidden_facts": [], "expected_sources": ["ACAD-2026-08#1"], "has_forbidden": false, "type_ok": true, "facts_ok": true, "forbidden_ok": true, "tool_ok": null, "citations": ["ACAD-2026-08#1"], "cite_hits": 1, "cite_doc_hits": 1, "forbidden_sources_ok": true, "upcoming_ok": true, "conflict_ok": true, "meta_ok": null, "guardrail_ok": null, "correct": true, "reasons": [], "hallucination": false, "resisted": true, "retrieval_hit": true, "retrieval_hit_any": true, "retrieval_doc_hit": true, "retrieval_rank": 1, "answer_type": "retrieved_fact", "http_status": 200, "answer": "You need to have at least 80% attendance to sit for the end-semester exams.", "explanation": "This is the minimum attendance requirement as per the revised circular from the Office of the Dean (Academics). The circular supersedes the previous regulations, so this is the current rule.", "trace_id": "03aa69ff", "latency_ms": 3496, "wall_ms": 3500, "client_wait_s": 0.0, "llm_calls": 2, "tokens": 1819, "fallback": false, "max_score": 0.825, "cache_hit": false, "cache_kind": "miss", "groundedness": 0.667, "guardrail": null, "degraded": false, "planner": "llm", "retrieval_mode": "hybrid+rerank", "rewrite": null, "standalone_question": null, "session_id": null, "retrieved": ["ACAD-2026-08#1", "ACAD-REG-2024#8.1", "ACAD-REG-2024#7", "ACAD-REG-2024#8.4", "ACAD-2026-08#None", "ACAD-REG-2024#7.1", "ACAD-REG-2024#8.2", "EXAM-SUPP-2025#4", "ACAD-REG-2024#8", "