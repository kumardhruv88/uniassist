CAD-REG-2024#9", "ACAD-2026-08#3"], "response": {"answer": "CGPA is calculated as the credit-weighted average of grade points of all courses passed, rounded to two decimal places.", "explanation": "You can find the formula for calculating CGPA in the Academic Regulations for B.Tech Programmes. It's the credit-weighted average of grade points of all courses passed, rounded to two decimal places.", "citations": [{"doc_id": "ACAD-REG-2024", "section": "9.2", "title": "Academic Regulations for B.Tech Programmes", "version": "3.1", "effective_from": "2024-07-01"}], "tools": [], "applied_rules": [], "conflicts": [], "upcoming": [], "clarification_options": [], "meta": {"cache_hit": false, "cache": "miss", "latency_ms": 3312, "guardrail": null, "output_redactions": [], "groundedness": 1.0, "session_id": null, "standalone_question": null, "rewrite": null, "degraded": false, "planner": "llm", "retrieval": "hybrid+rerank", "llm_calls": 2, "tokens": 1684, "tokens_saved": 0}}}
