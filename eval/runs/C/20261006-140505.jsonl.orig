{"id": "VC8", "bucket": "versions_conflicts", "tags": ["as_of", "boundary", "version", "attendance"], "difficulty": "hard", "question": "What is the minimum attendance required to sit end-semester exams?", "student_id": null, "as_of_date": "2026-07-31", "session": null, "turn": null, "repeat_of": null, "expected_types": ["retrieved_fact"], "expected_answer_type": "retrieved_fact", "reference": "75% on 31 July 2026 (ACAD-REG-2024 \u00a77.2); the 80% circular starts the next day (upcoming change).", "expected_facts": ["75"], "expected_regex": [], "forbidden_facts": [], "expected_sources": ["ACAD-REG-2024#7.2"], "has_forbidden": false, "type_ok": true, "facts_ok": true, "forbidden_ok": true, "tool_ok": null, "citations": ["ACAD-REG-2024#7.2"], "cite_hits": 1, "cite_doc_hits": 1, "forbidden_sources_ok": true, "upcoming_ok": true, "conflict_ok": true, "meta_ok": null, "guardrail_ok": null, "correct": true, "reasons": [], "hallucination": false, "resisted": true, "retrieval_hit": true, "retrieval_hit_any": true, "retrieval_doc_hit": true, "retrieval_rank": 1, "answer_type": "retrieved_fact", "http_status": 200, "answer": "You need to have a minimum of 75% attendance in each course to be eligible to appear in the end-semester examination of that course.", "explanation": "You must attend at least 75% of the sessions in each course to be allowed to take the end-semester exam. This is a requirement for all courses.", "trace_id": "15dee793", "latency_ms": 3318, "wall_ms": 3324, "client_wait_s": 0.0, "llm_calls": 2, "tokens": 1733, "fallback": false, "max_score": 0.825, "cache_hit": false, "cache_kind": "miss", "groundedness": 1.0, "guardrail": null, "degraded": false, "planner": "llm", "retrieval_mode": "hybrid+rerank", "rewrite": null, "standalone_question": null, "session_id": null, "retrieved": ["ACAD-REG-2024#7.2", "ACAD-REG-2024#8.1", "ACAD-REG-2024#7", "ACAD-REG-2024#8.4", "ACAD-REG-2024#7.1", "ACAD-REG-2024#8.2", "ACAD-REG-2024#7.3", "EXAM-SUPP-2025#4", "ACAD-REG-2024#8", "FEES-2026#1"], "response": {"answer": "You need to have a minimum of 75% attendance in each course to be eligible to appear in the end-semester examination of that course.", "explanation": "You must attend at least 75% of the sessions in each course to be allowed to take the end-semester exam. This is a requirement for all courses.", "citations": [{"doc_id": "ACAD-REG-2024", "section": "7.2", "title": "Academic Regulations for B.Tech Programmes", "version": "3.1", "effective_from": "2024-07-01"}], "tools": [{"tool": "get_rule", "input": {"parameter": "min_attendance_pct"}, "output": {"by_scope": [{"scope": "B.Tech", "rule_id": "ATT-MIN-01", "operator": ">=", "value": "75", "source_doc_id": "ACAD-REG-2024", "source_section": "7.2"}, {"scope": "other programmes", "result": "RULE_UNAVAILABLE"}]}, "status": "ok"}], "applied_rules": [{"rule_id": "ATT-MIN-01", "value": ">=75%", "source_doc_id": "ACAD-REG-2024", "source_section": "7.2", "parameter": "min_attendance_pct"}], "conflicts": [], "upcoming": ["ACAD-2026-08", "HELPDESK-FAQ-2026"], "clarification_options": [], "meta": {"cache_hit": false, "cache": "miss", "latency_ms": 3318, "guardrail": null, "output_redactions": [], "groundedness": 1.0, "session_id": null, "standalone_question": null, "rewrite": null, "degraded": false, "planner": "llm", "retrieval": "hybrid+rerank", "llm_calls": 2, "tokens": 1733, "tokens_saved": 0}}}
{"id": "VC9", "bucket": "versions_conflicts", "tags": ["paraphrase", "informal", "conflict", "condonation"], "difficulty": "hard", "question": "my senior said 65% attendance is fine if I give a medical certificate, is it true?", "student_id": null, "as_of_date": "2026-10-06", "session": null, "turn": null, "repeat_of": null, "expected_types": ["retrieved_fact"], "expected_answer_type": "retrieved_fact", "reference": "No. The minimum is 80% (ACAD-2026-08 \u00a71) and medical condonation covers at most a 10% shortage (\u00a77.3); the FAQ's 65% answer is outdated.", "expected_facts": ["80"], "expected_regex": [], "forbidden_facts": ["yes, 65"], "expected_sources": ["ACAD-2026-08#1", "ACAD-2026-08#2", "ACAD-REG-2024#7.3"], "has_forbidden": true, "type_ok": true, "facts_ok": true, "forbidden_ok": true, "tool_ok": null, "citations": ["ACAD-REG-2024#7.3", "ACAD-2026-08#1"], "cite_hits": 2, "cite_doc_hits": 2, "forbidden_sources_ok": true, "upcoming_ok": true, "conflict_ok": true, "meta_ok": null, "guardrail_ok": null, "correct": true, "reasons": [], "hallucination": false, "resisted": true, "retrieval_hit": true, "retrieval_hit_any": true, "retrieval_doc_hit": true, "retrieval_rank": 1, "answer_type": "retrieved_fact", "http_status": 200, "answer": "No: 65% is below the 80% minimum, and condonation on medical grounds covers a shortage of at most 10%, so attendance must be at least 70% even with a medical certificate.", "explanation": "You need to have at least 80% attendance to appear in the end-semester examination, and a medical certificate can only cover a shortage of up to 10%.", "trace_id": "c450d156", "latency_ms": 2811, "wall_ms": 2815, "client_wait_s": 0.0, "llm_calls": 1, "tokens": 1191, "fallback": false, "max_score": 0.852, "cache_hit": false, "cache_kind": "miss", "groundedness": 1.0, "guardrail": null, "degraded": false, "planner": "router_first", "retrieval_mode": "hybrid+rerank", "rewrite": null, "standalone_question": null, "session_id": null, "retrieved": 