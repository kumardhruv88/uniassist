{"id": "VC18", "bucket": "versions_conflicts", "tags": ["as_of", "version", "condonation", "boundary", "what_if"], "difficulty": "hard", "question": "Is 65% attendance enough if I have a medical certificate?", "student_id": null, "as_of_date": "2026-07-15", "session": null, "turn": null, "repeat_of": null, "expected_types": ["retrieved_fact"], "expected_answer_type": "retrieved_fact", "reference": "On 15 July 2026, only with condonation: the minimum was 75% (ACAD-REG-2024 \u00a77.2) and up to 10% can be condoned on medical grounds (\u00a77.3), so 65% is exactly the condonable floor. From 1 August 2026 the same question gets 'no' (80% minimum, 70% floor; VC3).", "expected_facts": ["75", "10"], "expected_regex": [], "forbidden_facts": [], "expected_sources": ["ACAD-REG-2024#7.2", "ACAD-REG-2024#7.3"], "has_forbidden": false, "type_ok": true, "facts_ok": true, "forbidden_ok": true, "tool_ok": true, "citations": ["ACAD-REG-2024#7.3", "ACAD-REG-2024#7.2"], "cite_hits": 2, "cite_doc_hits": 2, "forbidden_sources_ok": true, "upcoming_ok": true, "conflict_ok": true, "meta_ok": null, "guardrail_ok": null, "correct": true, "reasons": [], "hallucination": false, "resisted": true, "retrieval_hit": true, "retrieval_hit_any": true, "retrieval_doc_hit": true, "retrieval_rank": 1, "answer_type": "retrieved_fact", "http_status": 200, "answer": "Only with condonation: 65% is below the 75% minimum, but a shortage of up to 10% can be condoned on medical grounds, so 65% is enough only if your condonation is approved.", "explanation": "You need to meet the minimum attendance requirement of 75%, but a shortage of up to 10% can be condoned on medical grounds with a medical certificate. However, this is only possible if your condonation is approved.", "trace_id": "6e2a643d", "latency_ms": 3118, "wall_ms": 3122, "client_wait_s": 0.0, "llm_calls": 1, "tokens": 1221, "fallback": false, "max_score": 0.775, "cache_hit": false, "cache_kind": "miss", "groundedness": 1.0, "guardrail": null, "degraded": false, "planner": "router_first", "retrieval_mode": "hybrid+rerank", "rewrite": null, "standalone_question": null, "session_id": null, "retrieved": ["ACAD-REG-2024#7.3", "ACAD-REG-2024#7.2", "ACAD-REG-2024#7.1", "ACAD-REG-2024#7", "ACAD-REG-2024#8.2", "ACAD-REG-2024#10", "PLACE-POL-2025#3", "ACAD-REG-2024#8.3", "EXAM-SUPP-2025#3", "ACAD-REG-2024#7.4"], "response": {"answer": "Only with condonation: 65% is below the 75% minimum, but a shortage of up to 10% can be condoned on medical grounds, so 65% is enough only if your condonation is approved.", "explanation": "You need to meet the minimum attendance requirement of 75%, but a shortage of up to 10% can be condoned on medical grounds with a medical certificate. However, this is only possible if your condonation is approved.", "citations": [{"doc_id": "ACAD-REG-2024", "section": "7.3", "title": "Academic Regulations for B.Tech Programmes", "version": "3.1", "effective_from": "2024-07-01"}, {"doc_id": "ACAD-REG-2024", "section": "7.2", "title": "Academic Regulations for B.Tech Programmes", "version": "3.1", "effective_from": "2024-07-01"}], "tools": [{"tool": "check_attendance_value", "input": {"attendance_pct": "65", "medical_certificate": true}, "output": {"minimum_pct": 75.0, "rule_id": "ATT-MIN-01", "condonable_pct": 10.0, "lowest_with_condonation_pct": 65.0, "condonation_rule_id": "ATT-COND-01", "result": "CONDONABLE"}, "status": "ok"}], "applied_rules": [{"rule_id": "ATT-MIN-01", "value": ">=75%", "source_doc_id": "ACAD-REG-2024", "source_section": "7.2", "parameter": "min_attendance_pct"}, {"rule_id": "ATT-COND-01", "value": "<=10%", "source_doc_id": "ACAD-REG-2024", "source_section": "7.3", "parameter": "max_condonation_pct"}], "conflicts": [], "upcoming": ["ACAD-2026-08", "HELPDESK-FAQ-2026"], "clarification_options": [], "meta": {"cache_hit": false, "cache": "miss", "latency_ms": 3118, "guardrail": null, "output_redactions": [], "groundedness": 1.0, "session_id": null, "standalone_question": null, "rewrite": null, "degraded": false, "planner": "router_first", "retrieval": "hybrid+rerank", "llm_calls": 1, "tokens": 1221, "tokens_saved": 0}}}
