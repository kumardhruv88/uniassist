{"id": "MS6", "bucket": "multi_step", "tags": ["projection", "informal", "attendance"], "difficulty": "hard", "question": "Out of the next 10 Data Structures classes, how many can I bunk and still sit the end-sem?", "student_id": "S1002", "as_of_date": "2026-07-15", "session": null, "turn": null, "repeat_of": null, "expected_types": ["calculated"], "expected_answer_type": "calculated", "reference": "3: with 31/40 now and 10 more classes, missing 3 gives 38/50 = 76% >= 75%; missing 4 gives 74%.", "expected_facts": [], "expected_regex": [], "forbidden_facts": [], "expected_sources": [], "has_forbidden": false, "type_ok": true, "facts_ok": true, "forbidden_ok": true, "tool_ok": true, "citations": ["ACAD-REG-2024#7.2"], "cite_hits": null, "cite_doc_hits": null, "forbidden_sources_ok": true, "upcoming_ok": true, "conflict_ok": true, "meta_ok": null, "guardrail_ok": null, "correct": true, "reasons": [], "hallucination": false, "resisted": true, "retrieval_hit": null, "retrieval_hit_any": null, "retrieval_doc_hit": null, "retrieval_rank": null, "answer_type": "calculated", "http_status": 200, "answer": "Of the next 10 classes in Data Structures (CS201), you can miss at most 3 and still meet the required 75% (you have attended 31 of 40 so far).", "explanation": "The rule is that you must have at least 75% attendance in each course to be eligible to appear in the end-semester examination. According to the regulations, you have already attended 31 out of 40 classes, so you can miss up to 3 more classes out of the next 10 to meet the required 75% attendance.", "trace_id": "9fef90a0", "latency_ms": 3784, "wall_ms": 3788, "client_wait_s": 0.0, "llm_calls": 1, "tokens": 1084, "fallback": false, "max_score": 0.691, "cache_hit": false, "cache_kind": "miss", "groundedness": 1.0, "guardrail": null, "degraded": false, "planner": "router_first", "retrieval_mode": "hybrid+rerank", "rewrite": null, "standalone_question": null, "session_id": null, "retrieved": ["ACAD-REG-2024#7.2", "ACAD-