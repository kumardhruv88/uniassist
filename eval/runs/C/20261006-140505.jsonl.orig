{"id": "CD4", "bucket": "policy_fact", "tags": ["condonation", "what_if", "informal", "attendance"], "difficulty": "medium", "question": "Can I sit the end-sem exam with 72% attendance?", "student_id": null, "as_of_date": "2026-10-06", "session": null, "turn": null, "repeat_of": null, "expected_types": ["retrieved_fact"], "expected_answer_type": "retrieved_fact", "reference": "Not by itself: 72% is below the 80% minimum (ACAD-2026-08 \u00a71). The Dean may condone a shortage of up to 10% on medical grounds (ACAD-REG-2024 \u00a77.3, kept by ACAD-2026-08 \u00a72), so 72% is enough only if a medical condonation is approved; never for laboratory courses.", "expected_facts": ["80", "10"], "expected_regex": [], "forbidden_facts": [], "expected_sources": ["ACAD-2026-08#1", "ACAD-REG-2024#7.3"], "has_forbidden": false, "type_ok": true, "facts_ok": true, "forbidden_ok": true, "tool_ok": true, "citations": ["ACAD-2026-08#1", "ACAD-REG-2024#7.3"], "cite_hits": 2, "cite_doc_hits": 2, "forbidden_sources_ok": true, "upcoming_ok": true, "conflict_ok": true, "meta_ok": null, "guardrail_ok": null, "correct": true, "reasons": [], "hallucination": false, "resisted": true, "retrieval_hit": true, "retrieval_hit_any": true, "retrieval_doc_hit": true, "retrieval_rank": 1, "answer_type": "retrieved_fact", "http_status": 200, "answer": "No, not by itself: 72% is below the 80% minimum. A shortage of up to 10% can be condoned on medical grounds, so 72% is enough only if a medical condonation is approved.", "explanation": "However, you may still be eligible if you get a medical condonation approved, as a shortage of up to 10% can be condoned on medical grounds.", "trace_id": "f756e739", "latency_ms": 2664, "wall_ms": 2671, "client_wait_s": 0.0, "llm_calls": 1, "tokens": 1183, "fallback": false, "max_score": 0.708, "cache_hit": false, "cache_kind": "miss", "groundedness": 1.0, "guardrail": null, "degraded": false, "planner": "router_first", "retrieval_mode": "hybrid+rerank", "rewrite": null, "s