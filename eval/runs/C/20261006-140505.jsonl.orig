{"id": "VC5", "bucket": "versions_conflicts", "tags": ["as_of", "personal", "attendance"], "difficulty": "medium", "question": "Am I eligible for the CS201 end-semester exam?", "student_id": "S1002", "as_of_date": "2026-07-15", "session": null, "turn": null, "repeat_of": null, "expected_types": ["calculated"], "expected_answer_type": "calculated", "reference": "Yes (as of 15 July 2026): 31/40 = 77.50% meets the 75% minimum then in force (ACAD-REG-2024 \u00a77.2).", "expected_facts": [], "expected_regex": [], "forbidden_facts": [], "expected_sources": [], "has_forbidden": false, "type_ok": true, "facts_ok": true, "forbidden_ok": true, "tool_ok": true, "citations": ["ACAD-REG-2024#7.2"], "cite_hits": null, "cite_doc_hits": null, "forbidden_sources_ok": true, "upcoming_ok": true, "conflict_ok": true, "meta_ok": null, "guardrail_ok": null, "correct": true, "reasons": [], "hallucination": false, "resisted": true, "retrieval_hit": null, "retrieval_hit_any": null, "retrieval_doc_hit": null, "retrieval_rank": null, "answer_type": "calculated", "http_status": 200, "answer": "You are eligible to sit the Data Structures (CS201) end-semester exam: your attendance is 77.50%, which meets the required 75%.", "explanation": "Your attendance of 77.50% meets the required 75% minimum attendance. According to the Academic Regulations for B.Tech Programmes, a student must have a minimum of 75% attendance in each course to be eligible to appear in the end-semester examination.", "trace_id": "b963e906", "latency_ms": 3033, "wall_ms": 3038, "client_wait_s": 0.0, "llm_calls": 1, "tokens": 1078, "fallback": false, "max_score": 0.688, "cache_hit": false, "cache_kind": "miss", "groundedness": 1.0, "guardrail": null, "degraded": false, "planner": "router_first", "retrieval_mode": "hybrid+rerank", "rewrite": null, "standalone_question": null, "session_id": null, "retrieved": ["ACAD-REG-2024#7.2", "ACAD-REG-2024#8.4", "ACAD-REG-2024#8.1", "EXAM-SUPP-2025#1", "ACAD-REG-2024#5.1", "EXAM-SUPP-2025#2", "ACAD-REG-2024#8.3", "PLACE-POL-2025#3", "EXAM-SUPP-2025#4", "FEES-2026#1"], "response": {"answer": "You are eligible to sit the Data Structures (CS201) end-semester exam: your attendance is 77.50%, which meets the required 75%.", "explanation": "Your attendance of 77.50% meets the required 75% minimum attendance. According to the Academic Regulations for B.Tech Programmes, a student must have a minimum of 75% attendance in each course to be eligible to appear in the end-semester examination.", "citations": [{"doc_id": "ACAD-REG-2024", "section": "7.2", "title": "Academic Regulations for B.Tech Programmes", "version": "3.1", "effective_from": "2024-07-01"}], "tools": [{"tool": "check_exam_eligibility", "input": {"course_code": "CS201"}, "output": {"result": "ELIGIBLE", "classes_held": 40, "classes_attended": 31, "attendance_pct": 77.5, "threshold": 75.0, "rule_id": "ATT-MIN-01", "classes_needed": 0, "projected_attended": 31, "projected_held": 40}, "status": "ok"}], "applied_rules": [{"rule_id": "ATT-MIN-01", "value": ">=75%", "source_doc_id": "ACAD-REG-2024", "source_section": "7.2", "parameter": "min_attendance_pct"}], "conflicts": [], "upcoming": ["ACAD-2026-08"], "clarification_options": [], "meta": {"cache_hit": false, "cache": "miss", "latency_ms": 3033, "guardrail": null, "output_redactions": [], "groundedness": 1.0, "session_id": null, "standalone_question": null, "rewrite": null, "degraded": false, "planner": "router_first", "retrieval": "hybrid+rerank", "llm_calls": 1, "tokens": 1078, "tokens_saved": 63}}}
{"id": "VC6", "bucket": "versions_conflicts", "tags": ["as_of", "personal", "attendance"], "difficulty": "medium", "question": "Am I eligible for the CS201 end-semester exam?", "student_id": "S1002", "as_of_date": "2026-10-06", "session": null, "turn": null, "repeat_of": null, "expected_types": ["calculated"], "expected_answer_type": "calculated", "reference": "No (as of 6 October 2026): 77.50% is below the 80% minimum (ACAD-2026-08 \u00a71); attending the next 5 classes gives 36/45 = 80%.", "expected_facts": [], "expected_regex": [], "forbidden_facts": [], "expected_sources": ["ACAD-2026-08#1"], "has_forbidden": false, "type_ok": true, "facts_ok": true, "forbidden_ok": true, "tool_ok": true, "citations": ["ACAD-2026-08#1"], "cite_hits": 1, "cite_doc_hits": 1, "forbidden_sources_ok": true, "upcoming_ok": true, "conflict_ok": true, "meta_ok": null, "guardrail_ok": null, "correct": true, "reasons": [], "hallucination": false, "resisted": true, "retrieval_hit": true, "retrieval_hit_any": true, "retrieval_doc_hit": true, "retrieval_rank": 1, "answer_type": "calculated", "http_status": 200, "answer": "You are not eligible to sit the Data Structures (CS201) end-semester exam: your attendance is 77.50%, below the required 80%. Attending the next 5 classes would bring you to 36 of 45.", "explanation": "You need at least 80% attendance to be eligible for the exam, and your current attendance is 77.50%. Attending the next 5 classes would bring you to 36 of 45, which is still below the required percentage.", "trace_id": "42c56246", "latency_ms": 3099, "wall_ms": 3103, "client_wait_s": 0.0, "llm_calls": 1, "tokens": 1143, "fallback": false, "max_score": 0.688, "cache_hit": false, "cache_kind": "miss", "groundedness": 1.0, "guardrail": null, "degraded": false, "planner": "router_first", "retrieval_mode": "hybrid+rerank", "rewrite": null, "standalone_question": null, "session_id": null, "retrieved": ["ACAD-2026-08#1", "HELPDESK-FAQ-2026#3", "ACAD-REG-2024#8.4", "ACAD-REG-2024#8.1